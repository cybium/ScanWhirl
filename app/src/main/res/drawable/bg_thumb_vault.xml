<?xml version="1.0" encoding="utf-8"?>
<!-- Locked / Private / PDF-only placeholder: a dark scrim on the shared canvas,
     not a dimmed near-white sheet. The glyph says why no page may be shown. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/sw_canvas" />
    <stroke android:width="1dp" android:color="@color/sw_canvas_edge" />
    <corners android:radius="4dp" />
</shape>
