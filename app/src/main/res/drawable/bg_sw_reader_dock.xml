<?xml version="1.0" encoding="utf-8"?>
<!-- v2 UI: 07_reader_dock — the reader's floating glass dock: ink surface with
     24dp corners and a 1dp cyan hairline, over the page. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tok_surface" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="@color/sw_cyan_hair" />
</shape>
