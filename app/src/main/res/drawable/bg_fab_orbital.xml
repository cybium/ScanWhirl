<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer concentric ring -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="@color/cyan_primary" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Inner glass body with gap -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="#071424"
                android:gradientRadius="28dp"
                android:startColor="#143250"
                android:type="radial" />
            <stroke
                android:width="1dp"
                android:color="@color/cyan_border_idle" />
        </shape>
    </item>
</layer-list>
