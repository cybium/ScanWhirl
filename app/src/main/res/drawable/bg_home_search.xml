<?xml version="1.0" encoding="utf-8"?>
<!-- Home slice 2: tonal search field; a single accent ring only while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/rv_surface_2" />
            <stroke android:width="1.5dp" android:color="@color/rv_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/rv_surface" />
        </shape>
    </item>
</selector>
