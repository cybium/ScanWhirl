<?xml version="1.0" encoding="utf-8"?>
<!-- Vault mode: Scan becomes "Add" (move a saved scan in). Ink = commit; gold is
     reserved for purchase, so Private/vault styling stays neutral. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#330E1316">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/rv_commit" />
        </shape>
    </item>
</ripple>
