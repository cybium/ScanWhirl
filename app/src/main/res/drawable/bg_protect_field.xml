<?xml version="1.0" encoding="utf-8"?>
<!-- L3 v2: password field of the Protect/Unlock sheets (sw.css .field: 56dp, radius 16,
     void2 fill, 1dp white 8%; cyan when focused / .on). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/void_nebula" />
            <stroke
                android:width="1.2dp"
                android:color="@color/cyan_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/void_nebula" />
            <stroke
                android:width="1dp"
                android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
