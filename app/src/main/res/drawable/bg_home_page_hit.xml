<?xml version="1.0" encoding="utf-8"?>
<!-- Retrieval slice 5: one page of evidence inside a Home search row. A quiet
     hairline frame (not a card) so the page link reads as part of its document. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rv_accent_fill">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="@color/rv_hairline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</ripple>
