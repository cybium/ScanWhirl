<?xml version="1.0" encoding="utf-8"?>
<!--
    Orbit-dock chip (test25 Phase 3). state_selected = that category's ring
    is focused (set from GlobeHomeActivity). Default matches bg_chip_void so
    the swap is only visible when selected.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#2A00F0FF" />
            <stroke
                android:width="1.5dp"
                android:color="@color/cyan_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/chip_void" />
            <stroke
                android:width="1dp"
                android:color="@color/cyan_border_idle" />
        </shape>
    </item>
</selector>
