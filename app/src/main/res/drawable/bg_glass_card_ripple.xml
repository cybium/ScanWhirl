<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/cyan_pressed_fill">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/cyan_pressed_fill" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/cyan_primary" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#B80A172E"
                        android:startColor="#D11E3860"
                        android:type="linear" />
                    <stroke
                        android:width="1.2dp"
                        android:color="@color/cyan_border_active" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#B80A172E"
                        android:startColor="#D11E3860"
                        android:type="linear" />
                    <stroke
                        android:width="1.2dp"
                        android:color="@color/cyan_border_active" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#B807101F"
                        android:startColor="#D1162846"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/cyan_border_idle" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
