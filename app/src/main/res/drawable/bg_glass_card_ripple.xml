<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/cyan_pressed_fill">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <!-- Review slice 1: the current page in Arrange (only Review sets activated);
                 the visible ring is the currentRing overlay in item_page_grid. -->
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/rv_accent_fill" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/rv_accent" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/cyan_pressed_fill" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/cyan_primary" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="@color/tok_surface_2"
                        android:startColor="@color/tok_surface"
                        android:type="linear" />
                    <stroke
                        android:width="1.2dp"
                        android:color="@color/cyan_border_active" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="@color/tok_surface_2"
                        android:startColor="@color/tok_surface"
                        android:type="linear" />
                    <stroke
                        android:width="1.2dp"
                        android:color="@color/cyan_border_active" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="@color/tok_surface_2"
                        android:startColor="@color/tok_surface"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/cyan_border_idle" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
