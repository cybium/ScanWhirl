<?xml version="1.0" encoding="utf-8"?>
<!-- Council §4: a 1dp #FFFFFF@24% edge, 4dp "paper corner" radius, no glow and no
     heavy shadow. Drawn as a container FOREGROUND (over the page) so the white
     sheet always reads as an object on the sw_canvas ground. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="@color/sw_canvas_edge" />
    <corners android:radius="4dp" />
</shape>
