<?xml version="1.0" encoding="utf-8"?>
<!-- Slice 4: a tappable option on an ink sheet — tonal surface (like the dock) with
     the platform ripple, shared by the Import rows and the Tools tiles. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1FECEFF1">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rv_surface_2" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
