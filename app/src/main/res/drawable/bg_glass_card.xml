<?xml version="1.0" encoding="utf-8"?>
<!-- W5a: the former navy glass stops are semantic surfaces. A real light theme
     can no longer paint dark-on-dark text inside cards and fields. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/tok_surface"
                android:endColor="@color/tok_surface_2"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="@color/cyan_border_active" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/tok_surface"
                android:endColor="@color/tok_surface_2"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="@color/cyan_border_active" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/tok_surface"
                android:endColor="@color/tok_surface_2"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/cyan_border_idle" />
        </shape>
    </item>
</selector>
