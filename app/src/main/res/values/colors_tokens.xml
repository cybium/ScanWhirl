<?xml version="1.0" encoding="utf-8"?>
<!-- W5a: one design system. These are the LIGHT values of frontend-v09/core/tokens.css.
     The DARK mirror lives in values-night/colors_tokens.xml. Every legacy colour name
     in colors*.xml is an alias to one of these tokens, so all existing call sites follow
     the system theme without a second palette. Do not add ad-hoc hex values to screens. -->
<resources>
    <color name="tok_bg">#f3f6f7</color>
    <color name="tok_surface">#ffffff</color>
    <color name="tok_surface_2">#eef3f4</color>
    <color name="tok_surface_3">#e3eaec</color>
    <color name="tok_line">#d9e3e6</color>

    <color name="tok_text">#13252a</color>
    <color name="tok_text_2">#566d74</color>
    <!-- tokens.css light text-3 #87999e is 2.97:1 on white. Deepened to #52646a:
         worst case 4.9:1 on canvas (surface_3 is 5.09:1, white 6.2:1), so body
         text clears AA on every light surface. -->
    <color name="tok_text_3">#52646a</color>
    <!-- Derived from the tokens.css line role: a functional boundary clears 3:1 on surface. -->
    <color name="tok_boundary">#61747a</color>

    <color name="tok_accent">#007884</color>
    <color name="tok_on_accent">#ffffff</color>
    <color name="tok_accent_soft">#e0f1f3</color>
    <color name="tok_accent_line">#73007884</color>

    <!-- Light ok green is deepened from tokens.css #1d8a4b (4.04:1 on bg, 3.84:1
         on ok-soft) so the success pill and status text clear the AA floor. -->
    <color name="tok_ok">#16753e</color>
    <color name="tok_ok_soft">#e3f4ea</color>
    <!-- Deepened from tokens.css #9a6400 (4.47:1 on surface-2) to clear AA there. -->
    <color name="tok_warn">#946000</color>
    <color name="tok_warn_soft">#fff3db</color>
    <color name="tok_danger">#c0392b</color>
    <color name="tok_danger_soft">#fde8e6</color>

    <!-- 70% navy (was 45%) so white ink on this scrim clears 4.5:1 even over a
         white page thumbnail. -->
    <color name="tok_scrim">#b30a191e</color>
    <!-- Opaque badge fill: page-count / film-number chips and review step buttons
         carry dark ink in light and light ink in dark, over white, paper or a
         dark scan. A translucent scrim cannot serve both polarities at AA. -->
    <color name="tok_badge_fill">#e3eaec</color>
    <color name="tok_canvas">#dfe6e8</color>
    <color name="tok_pro">#8a5a00</color>
    <color name="tok_pro_soft">#fff1cf</color>

    <!-- Paper is never inverted, so ink printed on it stays dark in both themes. -->
    <color name="tok_on_paper">#13252a</color>
    <!-- Ink on the dark sheet/page scrim is white in both themes. -->
    <color name="tok_on_scrim">#ffffff</color>
    <!-- The preview backdrop behind a white paper card stays dark in both themes. -->
    <color name="tok_preview_backdrop">#162024</color>
    <!-- API 24-26 cannot draw light nav icons; keep the bar dark there in both themes. -->
    <color name="tok_nav_bar_dark">#0d1315</color>
    <!-- M3 switch: an OFF track/thumb that clear 3:1 on the card surface; the
         ON pair is tok_accent / tok_on_accent. -->
    <color name="tok_switch_track_off">#707980</color>
    <color name="tok_switch_thumb_off">#ffffff</color>

    <!-- Category identity hues keep their hue family but are deep enough in light
         mode to clear 4.5:1 on the light background (dark keeps the shipped hues). -->
    <color name="tok_cat_study">#1b7339</color>
    <color name="tok_cat_receipts">#a34a00</color>
    <color name="tok_cat_ids">#145a9e</color>
    <color name="tok_cat_forms">#6a3ab5</color>
    <color name="tok_cat_other">#5f7176</color>
</resources>
