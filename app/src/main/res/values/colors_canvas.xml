<?xml version="1.0" encoding="utf-8"?>
<!-- Council §4 / UI_100 §G3: ONE token for every surface that hosts a document
     page (full page, thumbnail, preview, compare pane, filmstrip cell). The page's
     own white stays; only its container is this dark neutral canvas. Never use
     Color.WHITE, #FFFFFFFF, sw_paper or sw_paper_thumb behind a page. -->
<resources>
    <color name="sw_canvas">#1E252A</color>
    <!-- 1dp page edge: white at 24% alpha. The white page against sw_canvas is
         the real separator (~14:1); this hairline just gives the paper a corner. -->
    <color name="sw_canvas_edge">#3DFFFFFF</color>
</resources>
