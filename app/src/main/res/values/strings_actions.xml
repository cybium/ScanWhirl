<?xml version="1.0" encoding="utf-8"?>
<!-- B2 (GPT-6.2 critique #3): the document Actions sheet, shared by the document
     viewer (dock Actions) and, later, the Library row overflow. The sheet is bound
     to one document id; its header repeats that document's own thumbnail and name. -->
<resources>
    <!-- Dock label and the sheet's pane title. "Actions" replaces "More". -->
    <string name="doc_actions">Actions</string>
    <!-- Dock label: "Read text" replaces "Text". Short enough for a quarter-width
         dock cell in Hindi at 130 % (the sheet row keeps btn_ocr_text). -->
    <string name="dock_read_text">OCR</string>
    <!-- Section header above Compress / Sign / Read text / Share. -->
    <string name="doc_actions_header">Document actions</string>
    <!-- Why a row is greyed out for a legacy Vault item. -->
    <string name="doc_actions_vault_reason">Take this document out of the Vault first.</string>
    <!-- The document behind a stale sheet id is gone (deleted while the sheet was open). -->
    <string name="doc_actions_missing">This document is no longer in your library.</string>

    <!-- UI-B6 (GPT judgement 2026-11-19b, item 1): the document workspace's seven named
         actions. Labels are short enough for a quarter-width cell at 360 dp; the panel
         reflows to two growing columns at 160 % type instead of shrinking them. -->
    <string name="doc_action_edit_crop">Edit &amp; crop</string>
    <!-- V3: the export row in the Actions sheet says plainly what it does and where it goes. -->
    <string name="doc_action_save_pdf">Save copy to Documents</string>
    <!-- Kept for source/tests only: the dock no longer prints this explanation line. -->
    <string name="doc_action_save_hint">Save PDF adds a copy in Documents.</string>
    <!-- Spoken name of the fourth dock cell; its visible label is the sheet's "Actions". -->
    <string name="doc_action_more_desc">Document actions</string>
    <!-- The gold word on Sign while the build is Free. Never a paywall claim by itself. -->
    <string name="doc_action_pro">Pro</string>
</resources>
