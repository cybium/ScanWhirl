<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScanWhirl.Serif" parent="Theme.ScanWhirl">
        <item name="android:fontFamily">serif</item>
    </style>
    <style name="Theme.ScanWhirl.Mono" parent="Theme.ScanWhirl">
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="GreetingSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_hologram_mid</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Global Typography System (System fonts only, preserves Serif/Mono user choice) -->
    <style name="TextAppearance.SW.Hud.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_hologram_hi</item>
    </style>

    <style name="TextAppearance.SW.Hud.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/cyan_primary</item>
    </style>

    <style name="TextAppearance.SW.Section" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/cyan_primary</item>
    </style>

    <style name="TextAppearance.SW.Card.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/text_hologram_hi</item>
    </style>

    <style name="TextAppearance.SW.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/text_hologram_hi</item>
    </style>

    <style name="TextAppearance.SW.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/text_hologram_mid</item>
    </style>

    <style name="TextAppearance.SW.Telemetry" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/cyan_primary</item>
    </style>

    <style name="TextAppearance.SW.Action" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.SW.Dialog.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/text_hologram_hi</item>
    </style>

    <style name="TextAppearance.SW.Dialog.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/text_hologram_mid</item>
    </style>

    <!-- UX L5-04: explicit role tokens, additive only. Body 16sp; metadata 12sp,
         Devanagari metadata 14sp with font padding so matras keep their base letters. -->
    <style name="TextAppearance.ScanWhirl.L5.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/ux_l5_text_body</item>
        <item name="android:textColor">@color/text_hologram_hi</item>
        <item name="android:includeFontPadding">true</item>
    </style>

    <style name="TextAppearance.ScanWhirl.L5.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/ux_l5_text_meta</item>
        <item name="android:textColor">@color/text_hologram_mid</item>
    </style>

    <style name="TextAppearance.ScanWhirl.L5.MetaHi" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/ux_l5_text_meta_hi</item>
        <item name="android:textColor">@color/text_hologram_mid</item>
        <item name="android:includeFontPadding">true</item>
    </style>
</resources>
