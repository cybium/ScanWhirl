<?xml version="1.0" encoding="utf-8"?>
<!-- G2-HONESTY (F-03): the API 30-and-older twin of data_extraction_rules.xml. allowBackup stays
     false, and if a backup ever runs it still copies nothing from any app domain. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
