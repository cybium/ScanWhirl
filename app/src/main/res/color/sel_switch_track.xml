<?xml version="1.0" encoding="utf-8"?>
<!-- W5a: one switch palette for SwitchMaterial and SwitchCompat. OFF is a neutral
     track that clears 3:1 on the card; ON is the accent; disabled is reduced. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/tok_surface_3" />
    <item android:state_checked="true" android:color="@color/tok_accent" />
    <item android:color="@color/tok_switch_track_off" />
</selector>
