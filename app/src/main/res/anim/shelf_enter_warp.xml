<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/sw_decelerate">
    <scale
        android:duration="360"
        android:fromXScale="1.06"
        android:fromYScale="1.06"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="60"
        android:toXScale="1.0"
        android:toYScale="1.0" />
    <translate
        android:duration="360"
        android:fromYDelta="24dp"
        android:startOffset="60"
        android:toYDelta="0" />
    <alpha
        android:duration="360"
        android:fromAlpha="0.0"
        android:startOffset="60"
        android:toAlpha="1.0" />
</set>
