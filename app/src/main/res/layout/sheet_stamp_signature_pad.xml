<?xml version="1.0" encoding="utf-8"?>
<!-- L5: draw a signature. The pad is a vector path editor; the saved result is a vector
     signature in SignatureStore, not a bitmap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_glass"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:letterSpacing="0.04"
        android:text="@string/stamp_signature_sheet_title"
        android:textColor="@color/text_hologram_hi"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.scanwhirl.app.ui.stamp.SignaturePadView
        android:id="@+id/signaturePad"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/bg_thumb_paper" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signatureCancel"
            style="@style/Widget.ScanWhirl.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:text="@string/stamp_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signatureSave"
            style="@style/Widget.ScanWhirl.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/stamp_signature_save" />
    </LinearLayout>
</LinearLayout>
