<?xml version="1.0" encoding="utf-8"?>
<!-- Slice 4: the Import chooser — two labelled, described options (Photos and PDF)
     on the Index's ink sheet. Content scrolls (NestedScrollView, like Tools) so the
     last option and the close button stay reachable at large font scales. Camera
     is deliberately absent: Scan is its own primary dock button. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_ink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/importTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_title"
                    android:textColor="@color/rv_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/importSubtitle"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/import_subtitle"
                    android:textColor="@color/rv_ink_2"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/importClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sw_close"
                app:tint="@color/rv_ink_2" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/importPhotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_sw_sheet_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="88dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_sw_icon_tile"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_sw_photos"
                app:tint="@color/rv_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/importPhotosTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_photos"
                    android:textColor="@color/rv_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/importPhotosDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/import_photos_desc"
                    android:textColor="@color/rv_ink_2"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="-90"
                android:src="@drawable/ic_sw_chev_d"
                app:tint="@color/rv_ink_3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/importPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_sw_sheet_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="88dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_sw_icon_tile"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_sw_pdf_file"
                app:tint="@color/rv_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/importPdfTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_pdf"
                    android:textColor="@color/rv_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/importPdfDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/import_pdf_desc"
                    android:textColor="@color/rv_ink_2"
                    android:textSize="13sp" />

                <!-- D1: the same sentence as every other PDF door, from ImportRasterNotice. -->
                <TextView
                    android:id="@+id/importPdfRasterNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/import_raster_notice"
                    android:textColor="@color/rv_ink_3"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="-90"
                android:src="@drawable/ic_sw_chev_d"
                app:tint="@color/rv_ink_3" />
        </LinearLayout>

        <TextView
            android:id="@+id/importOrderNote"
                    android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="4dp"
            android:text="@string/import_order_note"
            android:textColor="@color/rv_ink_3"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
