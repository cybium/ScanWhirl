<?xml version="1.0" encoding="utf-8"?>
<!-- test26 T4.3: the long-press quick-actions sheet for one Home card —
     Rename, Move to category, Share, Delete (owner decision: this sheet
     replaces T3.7's long-press → selection entry; `Select` still enters
     selection mode). Slice 4: ink surface, scrolls at large font scales. Rows are static; MainActivity wires them by id. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_ink"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="26dp"
    android:paddingEnd="12dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/qaTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:ellipsize="end"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:textColor="@color/rv_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/qaEditPages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_row"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/edit_pages"
        android:textColor="@color/rv_ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/qaRename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_row"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/rename"
        android:textColor="@color/rv_ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/qaMove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_row"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/move_to_category"
        android:textColor="@color/rv_ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/qaShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_row"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/share_pdf"
        android:textColor="@color/rv_ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/qaDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_row"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/delete"
        android:textColor="@color/rv_danger"
        android:textSize="15sp" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
