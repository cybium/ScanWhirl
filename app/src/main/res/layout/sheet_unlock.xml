<?xml version="1.0" encoding="utf-8"?>
<!-- L3 v2 Unlock sheet — mockup 09_unlock_sheet (from src/09_unlock_sheet.html):
     gold lock badge, "<name> is protected", password field with the tries-left error,
     Open, "or", Use password saved in Vault, Cancel + Remove protection….
     Binding: ui/protect/UnlockSheet.kt. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/unlockSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_protect_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_protect_badge">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock"
                app:tint="@color/gold_pro_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/unlockTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/rv_ink"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/unlock_sheet_note"
            android:textColor="@color/rv_ink_2"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@id/unlockPasswordRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_protect_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock_small"
                app:tint="@color/rv_ink_3" />

            <EditText
                android:id="@id/unlockPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/protect_password_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:singleLine="true"
                android:textColor="@color/rv_ink"
                android:textColorHint="@color/rv_ink_3"
                android:textSize="16sp" />

            <ImageButton
                android:id="@id/unlockPasswordShow"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/protect_show_password"
                android:padding="10dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/rv_ink_3" />
        </LinearLayout>

        <TextView
            android:id="@id/unlockError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_info"
            android:drawablePadding="6dp"
            android:drawableTint="@color/rv_danger"
            android:textColor="@color/rv_danger"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@id/unlockOpen"
            style="@style/Widget.ScanWhirl.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:text="@string/unlock_open"
            android:textSize="16sp"
            app:cornerRadius="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/protect_field_line" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/unlock_or"
                android:textColor="@color/rv_ink_3"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/protect_field_line" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@id/unlockVault"
            style="@style/Widget.ScanWhirl.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/unlock_use_vault"
            android:textSize="15sp"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_vault"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/cyan_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@id/unlockCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="@string/unlock_cancel"
                android:textColor="@color/rv_ink_2"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@id/unlockRemove"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="@string/unlock_remove"
                android:textColor="@color/cyan_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
