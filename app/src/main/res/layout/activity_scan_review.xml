<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:importantForAccessibility="no"
    android:orientation="vertical">
    <!-- G2: root takes the initial focus so the title field does not — otherwise the
         IME opens on entry (API 24/25) and covers Save. Tapping the title still focuses
         it, selects all and opens the keyboard. -->

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sf_appbar"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/scan"
            app:titleTextColor="@color/text_hologram_hi">

            <EditText
                android:id="@+id/titleInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="48dp"
                android:background="@drawable/bg_title_input"
                android:hint="@string/name_hint"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/text_hologram_hi"
                android:textColorHint="@color/text_hologram_dim"
                android:textSize="18sp" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- test26 T4.1: pick the category before saving — a single-select chip
         rail (chips built in code) under the title, with a hint while the
         name has not suggested anything yet. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/categoryRail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/categoryCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text="@string/category_unsorted_hint"
            android:textColor="@color/text_hologram_dim"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <com.scanwhirl.app.ui.pagegrid.PageGridView
        android:id="@+id/pageGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <LinearLayout
        android:id="@+id/selectBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_hologram_hi"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelClear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear_selection"
            android:textColor="@color/text_hologram_mid"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/text_hologram_mid" />
    </LinearLayout>

    <!-- test25 Phase 5B: inset floating glass dock. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:background="@drawable/bg_dock_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <!-- test26 T5.3: DockItem — minHeight 56dp, glass dock + 8dp margins kept. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePdf"
            style="@style/Widget.ScanWhirl.Button.DockItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/review_save_pdf" />
    </LinearLayout>
</LinearLayout>
