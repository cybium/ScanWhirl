<?xml version="1.0" encoding="utf-8"?>
<!-- Home slice 2 — the Index (dark set, coherent with Review Focus/Arrange).
     Top to bottom: identity · search names and text · category filters · (Quick sort
     row when needed) · list header · documents · dock (Tools · Scan · Import).
     No wallpaper (a user-chosen one from Settings still applies), no greeting by
     default, no crown, no glow strokes. Cyan appears once: the Scan pill. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rv_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:importantForAccessibility="no">
    <!-- G2: the root holds the initial focus so the first EditText (search) does not
         grab it — on API 24/25 a focused field made the IME open on launch. The root
         is not an accessibility stop (importantForAccessibility=no); tapping search
         still focuses it and opens the keyboard normally. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/sf_appbar"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize"
                android:paddingVertical="4dp"
                app:contentInsetEnd="0dp"
                app:contentInsetStart="16dp"
                app:titleTextColor="@color/rv_ink">

                <LinearLayout
                    android:id="@+id/titleBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/titleRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/brandMark"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/avd_sw_brand_whirl" />

                        <TextView
                            android:id="@+id/appNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/app_name"
                            android:textColor="@color/rv_ink"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <!-- Pro/Free entry, demoted: a neutral hairline tag (no crown, no
                             gold). Still the one Home path to the Pro panel. -->
                        <TextView
                            android:id="@+id/proBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_home_pro_tag"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:letterSpacing="0.06"
                            android:minHeight="28dp"
                            android:paddingHorizontal="8dp"
                            android:text="@string/badge_pro"
                            android:textColor="@color/rv_ink_3"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- test26 T8.1: signal dot — lit while background work
                             runs (OCR/merge/compress), breathing only when
                             SwMotion.ambientAllowed. -->
                        <View
                            android:id="@+id/signalDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_signal_dot"
                            android:backgroundTint="@color/rv_warn"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Opt-in (Settings › status line): count + size readout. Off by
                         default since Home slice 2. -->
                    <TextView
                        android:id="@+id/statusLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.12"
                        android:maxLines="3"
                        android:textColor="@color/rv_ink_3"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>

            <!-- test26 T3.7/T3.12: contextual selection header — X · full
                 `N selected` · Select all. Replaces the toolbar row while
                 selecting (gear hides with it). -->
            <LinearLayout
                android:id="@+id/selectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="?attr/actionBarSize"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnSelClose"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close"
                    android:src="@drawable/ic_sw_close"
                    app:tint="@color/rv_ink" />

                <!-- T3.12: own space, never ellipsized. -->
                <TextView
                    android:id="@+id/selCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textColor="@color/rv_ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSelSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="@string/select_all"
                    android:textColor="@color/rv_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_home_search"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sw_search_pages"
                    app:tint="@color/rv_ink_2" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:singleLine="true"
                    android:textColor="@color/rv_ink"
                    android:textColorHint="@color/rv_ink_3"
                    android:textCursorDrawable="@null"
                    android:textSize="16sp" />

                <!-- test26 T3.5: clear (×) — only while there is text to clear. -->
                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_clear"
                    android:padding="13dp"
                    android:src="@drawable/ic_sw_close"
                    android:visibility="gone"
                    app:tint="@color/rv_ink_2" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- test26 T3.1/T3.4: category filter rail, built in code
             (MainActivity.buildChipRail); GONE until the first render. -->
        <HorizontalScrollView
            android:id="@+id/chipRail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- T4.4: Quick sort, calmer — a single quiet row (label built in code),
             only while Unsorted/Other documents exist. -->
        <LinearLayout
            android:id="@+id/nudge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- test26 T3.1/T3.5: list header — count, sort selector, Select. -->
        <com.scanwhirl.app.ui.AdaptiveHeaderRow
            android:id="@+id/listHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/headerCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAllCaps="false"
                android:textColor="@color/rv_ink_3"
                android:textSize="13sp" />

            <!-- G2: sort + Select stay together; AdaptiveHeaderRow drops them onto their
                 own end-aligned row when the count cannot fit beside them (large font). -->
            <LinearLayout
                android:id="@+id/headerActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sortSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_sw_sort"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/rv_ink_2"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="2"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="8dp"
                    android:textColor="@color/rv_ink_2"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnSelect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/select"
                    android:textColor="@color/rv_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.scanwhirl.app.ui.AdaptiveHeaderRow>

        <!-- Hidden Vault (4-digit PIN) open banner. Neutral, not gold: gold means purchase. -->
        <LinearLayout
            android:id="@+id/vaultBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_home_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sw_private"
                app:tint="@color/rv_ink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_banner_title"
                    android:textColor="@color/rv_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_banner_sub"
                    android:textColor="@color/rv_ink_2"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVaultChangePin"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/vault_change_pin"
                android:textColor="@color/rv_accent"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVaultLock"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/vault_exit"
                android:textColor="@color/rv_ink"
                android:textSize="12sp"
                app:strokeColor="@color/rv_hairline" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/scanList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="4dp"
                android:paddingTop="2dp"
                android:paddingEnd="4dp"
                android:paddingBottom="16dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical" />

            <!-- Empty states (fresh library / filter hides all / empty vault). Scrolls
                 so 200% text never clips; the dock below is the call to action. -->
            <ScrollView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="28dp"
                    android:paddingVertical="16dp">

                    <ImageView
                        android:id="@+id/emptyFrame"
                        android:layout_width="200dp"
                        android:layout_height="160dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ill_home_empty" />

                    <TextView
                        android:id="@+id/emptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="@string/empty_home_title"
                        android:textColor="@color/rv_ink"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/emptySubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3sp"
                        android:text="@string/empty_home_body"
                        android:textColor="@color/rv_ink_2"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/emptyNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:drawableStart="@drawable/ic_sw_private"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/rv_ink_3"
                        android:gravity="center_vertical"
                        android:text="@string/empty_home_note"
                        android:textColor="@color/rv_ink_3"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <!-- Legacy first-run buttons: kept GONE — the dock's labelled Scan and
                         Import are the one call to action (one primary per screen). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyScan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="@color/sw_scan"
                        android:minHeight="52dp"
                        android:text="@string/empty_scan_button"
                        android:textColor="@color/sw_on_scan"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyImport"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="52dp"
                        android:text="@string/empty_import_button"
                        android:textColor="@color/rv_accent"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <!-- test26 T3.8: only in the filter-empty state. -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnShowAll"
                        style="@style/Widget.ScanWhirl.Chip.Home"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:checkable="false"
                        android:text="@string/show_all"
                        android:textColor="@color/rv_accent"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Dock: Tools · Scan · Import, each labelled. Scan is a cyan pill inside the
             dock (no protruding disc, so nothing overlaps the list). Restrained press
             feedback: sw_press (0.97 scale, animator-scale aware) + ripple. -->
        <FrameLayout
            android:id="@+id/dockRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_dock"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:padding="6dp">

                <LinearLayout
                    android:id="@+id/btnTools"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="60dp"
                    android:orientation="vertical"
                    android:paddingVertical="4dp"
                    android:stateListAnimator="@animator/sw_press">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sw_tools"
                        app:tint="@color/rv_ink" />

                    <TextView
                        style="@style/Widget.ScanWhirl.HomeDockLabel"
                        android:text="@string/bar_tools" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnScan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1.5"
                    android:clickable="true"
                    android:contentDescription="@string/scan"
                    android:focusable="true"
                    android:minHeight="56dp"
                    android:stateListAnimator="@animator/sw_press">

                    <LinearLayout
                        android:id="@+id/scanButtonDisc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_home_scan_pill"
                        android:duplicateParentState="true"
                        android:gravity="center"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:id="@+id/scanIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sw_scan"
                            app:tint="@color/sw_on_scan" />

                        <TextView
                            android:id="@+id/scanLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:maxLines="1"
                            android:text="@string/bar_scan"
                            android:textColor="@color/sw_on_scan"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/btnImport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/empty_import_button"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="60dp"
                    android:orientation="vertical"
                    android:paddingVertical="4dp"
                    android:stateListAnimator="@animator/sw_press">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sw_import"
                        app:tint="@color/rv_ink" />

                    <TextView
                        style="@style/Widget.ScanWhirl.HomeDockLabel"
                        android:text="@string/bar_import" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- test26 T3.12: contextual action bar while selecting — replaces the dock. -->
        <LinearLayout
            android:id="@+id/selectionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_home_dock"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelMove"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/move"
                android:textColor="@color/home_dock_item"
                app:icon="@drawable/ic_sw_category"
                app:iconTint="@color/home_dock_item" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelMerge"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/merge"
                android:textColor="@color/home_dock_item"
                app:icon="@drawable/ic_merge"
                app:iconTint="@color/home_dock_item" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelExport"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/export"
                android:textColor="@color/home_dock_item"
                app:icon="@drawable/ic_download"
                app:iconTint="@color/home_dock_item" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelDelete"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/delete"
                android:textColor="@color/home_dock_danger"
                app:icon="@drawable/ic_sw_delete"
                app:iconTint="@color/home_dock_danger" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
