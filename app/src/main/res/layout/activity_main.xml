<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/sf_appbar"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize"
                android:paddingVertical="6dp"
                app:contentInsetStart="0dp"
                app:contentInsetEnd="0dp"
                app:titleTextColor="@color/text_hologram_hi">

                <LinearLayout
                    android:id="@+id/titleBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/titleRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/appNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.04"
                            android:text="@string/app_name"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="@color/text_hologram_hi"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/proBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pro_badge"
                            android:clickable="true"
                            android:drawableStart="@drawable/ic_crown"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/pro_gold"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/badge_pro"
                            android:textColor="@color/pro_gold"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- test26 T8.1: signal dot — 3dp, lit while background work
                             runs (OCR/merge/compress), breathing only when
                             SwMotion.ambientAllowed. -->
                        <View
                            android:id="@+id/signalDot"
                            android:layout_width="3dp"
                            android:layout_height="3dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_signal_dot"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- test26 T3.2: HUD status line — 11sp caps + 0.12 tracking (R2
                         micro-label exception), dim cyan; digits monospace and the
                         separators hairline-coloured via StatusLine.styled(). -->
                    <TextView
                        android:id="@+id/statusLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.12"
                        android:maxLines="1"
                        android:textColor="@color/cyan_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>

            <!-- test26 T3.7/T3.12: contextual selection header — X · full
                 `N selected` · Select all (§4.2 Rev 3). The four actions
                 moved to selectionBar: four actions + count on this one row
                 clipped the count (complaint #15). Replaces the toolbar row
                 while selecting (gear hides with it). -->
            <LinearLayout
                android:id="@+id/selectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="?attr/actionBarSize"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnSelClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_hologram_hi" />

                <!-- T3.12: own space, never ellipsized — the count is the
                     one thing this row exists to show. -->
                <TextView
                    android:id="@+id/selCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textColor="@color/text_hologram_hi"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSelSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="@string/select_all"
                    android:textColor="@color/cyan_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/cyan_primary" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/text_hologram_hi"
                    android:textColorHint="@color/text_hologram_dim"
                    android:textSize="14sp" />

                <!-- test26 T3.5: clear (×) — appears only while there is text
                     to clear. -->
                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/search_clear"
                    android:padding="12dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/cyan_dim" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- test26 T3.1/T3.4: category chip rail. Built in code by
             MainActivity.buildChipRail() (counts change with the library);
             GONE in XML until the first refreshList fills it. -->
        <HorizontalScrollView
            android:id="@+id/chipRail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                app:selectionRequired="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- test26 T3.1: Quick Sort nudge — stays GONE until T4.4 (owner decision). -->
        <LinearLayout
            android:id="@+id/nudge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- test26 T3.1/T3.5: list header — "N documents"/"N in Category",
             sort selector (PopupMenu), Select. Built in code; GONE in XML
             until the first updateListHeader() runs. -->
        <LinearLayout
            android:id="@+id/listHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/headerCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/cyan_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/sortSelector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/sort"
                android:focusable="true"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:textColor="@color/cyan_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:text="@string/select"
                android:textColor="@color/cyan_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hidden Vault active banner (shown only when 4-digit PIN Vault is open) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vaultBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/sf_pro_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/pro_badge_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_vault"
                    app:tint="@color/pro_gold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vault_banner_title"
                        android:textColor="@color/pro_gold"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vault_banner_sub"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVaultChangePin"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/vault_change_pin"
                    android:textColor="@color/pro_gold"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVaultLock"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/vault_exit"
                    android:textColor="@color/pro_gold"
                    android:textSize="12sp"
                    app:strokeColor="@color/pro_badge_stroke" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/scanList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="40dp" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <!-- test26 T3.8: viewfinder brackets replace the orbit icon;
                     the SCAN button in the dock is the call to action. -->
                <ImageView
                    android:id="@+id/emptyFrame"
                    android:layout_width="96dp"
                    android:layout_height="128dp"
                    android:contentDescription="@null"
                    android:src="@drawable/frame_corners"
                    app:tint="@color/cyan_primary" />

                <TextView
                    android:id="@+id/emptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/empty_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/text_hologram_hi" />

                <TextView
                    android:id="@+id/emptySubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/empty_first_scan_hint"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/text_hologram_mid"
                    android:visibility="gone" />

                <!-- First-run: filled cyan scan button + text import button. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="52dp"
                    android:backgroundTint="@color/cyan_primary"
                    android:text="@string/empty_scan_button"
                    android:textColor="@color/void_abyss"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyImport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="52dp"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:text="@string/empty_import_button"
                    android:textColor="@color/cyan_primary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- test26 T3.8: only in the filter-empty state — clears the
                     query and the category so everything shows again. -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/btnShowAll"
                    style="@style/Widget.ScanWhirl.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/show_all"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- test26 T6/U1-U2: Dock with raised Scan disc overlapping the list.
             dockRoot top margin is -28dp so the disc protrudes above the dock;
             touches in the transparent band fall through to the list. -->
        <FrameLayout
            android:id="@+id/dockRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="-28dp"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:minHeight="64dp"
                android:background="@drawable/bg_dock_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <!-- btnTools (weight 1) -->
                <LinearLayout
                    android:id="@+id/btnTools"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tools"
                        app:tint="@color/cyan_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/bar_tools"
                        android:textColor="@color/text_hologram_mid"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Fixed 96dp spacer under the disc -->
                <Space
                    android:layout_width="96dp"
                    android:layout_height="1dp" />

                <!-- btnImport (weight 1) -->
                <LinearLayout
                    android:id="@+id/btnImport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_import"
                        app:tint="@color/cyan_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/bar_import"
                        android:textColor="@color/text_hologram_mid"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Scan disc: 96dp wide container, 64dp disc, top-aligned centered -->
            <LinearLayout
                android:id="@+id/btnScan"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/scan">

                <FrameLayout
                    android:id="@+id/scanButtonDisc"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_scan_button"
                    android:elevation="8dp"
                    android:outlineSpotShadowColor="@color/cyan_primary"
                    android:outlineAmbientShadowColor="@color/cyan_primary"
                    android:stateListAnimator="@animator/sw_press"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:id="@+id/scanIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_document_scanner"
                        app:tint="@color/void_abyss" />
                </FrameLayout>

                <TextView
                    android:id="@+id/scanLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/bar_scan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/cyan_primary" />
            </LinearLayout>
        </FrameLayout>

        <!-- test26 T3.12 (§4.2 Rev 3): contextual action bar while selecting
             — replaces the SCAN bar. This amends the approved T3.7 rule
             "bottom bar hidden while selecting": same intent (no SCAN while
             picking), better use of the space. §5.4 dock items (icon over
             label, weight 1, minHeight 56dp); inset-aware because the screen
             root already carries the system-bar padding (T1.1).
             Enable rules: Move dead until T4.3, Merge needs ≥ 2, Export /
             Delete ≥ 1 (Export stays Pro-only — Free keeps no dead buttons);
             Delete is tinted with the danger colour. -->
        <LinearLayout
            android:id="@+id/selectionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_dock_glass"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelMove"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/move"
                app:icon="@drawable/ic_move" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelMerge"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/merge"
                app:icon="@drawable/ic_merge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelExport"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/export"
                app:icon="@drawable/ic_download" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelDelete"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/delete"
                android:textColor="@color/laser_danger"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/laser_danger" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
