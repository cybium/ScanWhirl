<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/sf_appbar"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize"
                android:paddingVertical="6dp"
                app:titleTextColor="@color/text_hologram_hi">

                <LinearLayout
                    android:id="@+id/titleBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/titleRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/appNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.04"
                            android:text="@string/app_name"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="@color/text_hologram_hi"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/proBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pro_badge"
                            android:clickable="true"
                            android:drawableStart="@drawable/ic_crown"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/pro_gold"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/badge_pro"
                            android:textColor="@color/pro_gold"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/text_hologram_mid"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/cyan_primary" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/text_hologram_hi"
                    android:textColorHint="@color/text_hologram_dim"
                    android:textSize="14sp" />

                <!-- Sort pill (test25): ic_sort + live sortLabel. Was an ImageButton. -->
                <LinearLayout
                    android:id="@+id/btnSort"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_search_bar"
                    android:clickable="true"
                    android:contentDescription="@string/sort"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_sort"
                        app:tint="@color/cyan_primary" />

                    <TextView
                        android:id="@+id/sortLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/sort_date"
                        android:textColor="@color/cyan_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- test26 T3.1: category chip rail — filled in T3.4 (empty + GONE for now). -->
        <HorizontalScrollView
            android:id="@+id/chipRail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp" />
        </HorizontalScrollView>

        <!-- test26 T3.1: Quick Sort nudge — stays GONE until T4.4 (owner decision). -->
        <LinearLayout
            android:id="@+id/nudge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- test26 T3.1: list header (count · sort · select) — filled in T3.5. -->
        <LinearLayout
            android:id="@+id/listHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone" />

        <!-- Hidden Vault active banner (shown only when 4-digit PIN Vault is open) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vaultBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/sf_pro_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/pro_badge_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_vault"
                    app:tint="@color/pro_gold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vault_banner_title"
                        android:textColor="@color/pro_gold"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vault_banner_sub"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVaultChangePin"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/vault_change_pin"
                    android:textColor="@color/pro_gold"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVaultLock"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/vault_exit"
                    android:textColor="@color/pro_gold"
                    android:textSize="12sp"
                    app:strokeColor="@color/pro_badge_stroke" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/toolsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolResize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/sw_press"
                    app:cardBackgroundColor="@color/glass_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/sel_stroke_cyan"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge_glow"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_resize"
                            app:tint="@color/cyan_primary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tool_resize"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="@color/text_hologram_hi"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tool_resize_sub"
                                android:textColor="@color/text_hologram_mid"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolCompress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/sw_press"
                    app:cardBackgroundColor="@color/glass_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/sel_stroke_cyan"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge_glow"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_compress"
                            app:tint="@color/cyan_primary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tool_compress"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="@color/text_hologram_hi"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tool_compress_sub"
                                android:textColor="@color/text_hologram_mid"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/sw_press"
                    app:cardBackgroundColor="@color/glass_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/sel_stroke_cyan"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge_glow"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/cyan_primary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tool_edit"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="@color/text_hologram_hi"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tool_edit_sub"
                                android:textColor="@color/text_hologram_mid"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolMerge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/sw_press"
                    app:cardBackgroundColor="@color/glass_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/sel_stroke_cyan"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge_glow"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_merge"
                            app:tint="@color/cyan_primary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tool_merge"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="@color/text_hologram_hi"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tool_merge_sub"
                                android:textColor="@color/text_hologram_mid"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Expandable Pro Suite: one sleek button that expands all Pro tools -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/proSuiteCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/gold_pro_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/pro_badge_stroke"
                app:strokeWidth="1dp">

                <!--
                    bg_pro_banner (the gradient + gold hairline) lives on the content
                    container, NOT on app:cardBackgroundColor: cardBackgroundColor is a
                    format="color" attr, and ResourcesImpl.loadComplexColorForCookie()
                    only parses <gradient>/<selector> roots — a <shape> throws
                    NotFoundException at inflation. The 1dp margin keeps the card's own
                    pro_badge_stroke visible above the child.
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pro_banner"
                    android:layout_margin="1dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btnProSuite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_crown"
                            app:tint="@color/pro_gold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/pro_suite_title"
                            android:textColor="@color/pro_gold"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/pro_suite_sub"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/proSuiteChevron"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:rotation="0"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/pro_gold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/proSuiteGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/toolVault"
                                style="@style/Widget.ScanWhirl.Button.Pro"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:maxLines="1"
                                android:paddingHorizontal="10dp"
                                android:text="@string/vault_title"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"
                                app:icon="@drawable/ic_vault"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="17dp"
                                app:iconTint="@color/pro_gold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/toolOcr"
                                style="@style/Widget.ScanWhirl.Button.Pro"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:maxLines="1"
                                android:paddingHorizontal="10dp"
                                android:text="@string/btn_ocr_text"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"
                                app:icon="@drawable/ic_ocr"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="17dp"
                                app:iconTint="@color/pro_gold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/toolLockPdf"
                                style="@style/Widget.ScanWhirl.Button.Pro"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:maxLines="1"
                                android:paddingHorizontal="10dp"
                                android:text="@string/btn_lock_unlock"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"
                                app:icon="@drawable/ic_lock"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="17dp"
                                app:iconTint="@color/pro_gold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/toolLongImage"
                                style="@style/Widget.ScanWhirl.Button.Pro"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_margin="3dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:maxLines="1"
                                android:paddingHorizontal="10dp"
                                android:text="@string/btn_long_image"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"
                                app:icon="@drawable/ic_long_image"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="17dp"
                                app:iconTint="@color/pro_gold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/scanList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="96dp" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <ImageView
                    android:id="@+id/emptyOrbit"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_empty_orbit"
                    app:tint="@color/cyan_primary" />

                <TextView
                    android:id="@+id/emptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/empty_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/text_hologram_hi" />

                <TextView
                    android:id="@+id/emptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/empty_subtitle"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/text_hologram_mid" />
            </LinearLayout>
        </FrameLayout>

        <!-- test26 T3.1: bottom bar (Tools · SCAN · Vault) — built in T3.6, GONE for now. -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!--
        Orbital FAB host (test25 Phase 2, item 6): 96dp FrameLayout carrying two static
        rings behind the scan FAB. The host sits where the FAB used to, so the outer ring
        inherits the old 24dp screen inset and the FAB centers inside it.
        The rings are intentionally NOT animated here — pulse motion is Phase 4 and must
        be gated on SwMotion.ambientAllowed() (does not exist yet).
        Visibility of fabHost must always track fabScan (tests read fabScan directly).
    -->
    <FrameLayout
        android:id="@+id/fabHost"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp">

        <View
            android:id="@+id/fabRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/bg_fab_outer_ring" />

        <View
            android:id="@+id/fabPulse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/bg_fab_pulse" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/scan"
            android:src="@drawable/ic_camera"
            app:backgroundTint="@color/cyan_primary"
            app:elevation="0dp"
            app:hoveredFocusedTranslationZ="0dp"
            app:pressedTranslationZ="0dp"
            app:tint="@color/sf_on_primary" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
