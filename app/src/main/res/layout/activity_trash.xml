<?xml version="1.0" encoding="utf-8"?>
<!-- M07 P1: Trash. Toolbar (Up + Empty Trash), a one-paragraph explanation, the
     list, and real empty / error states. Insets are applied in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sf_appbar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.ScanWhirl.Overflow48"
            app:navigationContentDescription="@string/trash_navigate_up"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/trash_title"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <TextView
        android:id="@+id/trashCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:textColor="@color/rv_ink_2"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/trashHeaderNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="@string/trash_header_note"
        android:textColor="@color/rv_ink_2"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/trashList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/trashEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingTop="56dp"
                android:paddingBottom="32dp">

                <ImageView
                    android:id="@+id/trashEmptyIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.3"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_brand_mark" />

                <TextView
                    android:id="@+id/trashEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/trash_empty_title"
                    android:textColor="@color/rv_ink"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/trashEmptyBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/trash_empty_body"
                    android:textColor="@color/rv_ink_2"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrashRetry"
                    style="@style/Widget.ScanWhirl.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:text="@string/trash_retry"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
