<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/fileInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/text_hologram_mid" />

    <!-- FF-R: the two honest fits. There is deliberately no stretch option. -->
    <RadioGroup
        android:id="@+id/resizeModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/resizeModeCrop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="48dp"
            android:text="@string/resize_mode_crop"
            android:textColor="@color/text_hologram_hi"
            app:buttonTint="@color/cyan_primary" />

        <RadioButton
            android:id="@+id/resizeModeBorders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/resize_mode_borders"
            android:textColor="@color/text_hologram_hi"
            app:buttonTint="@color/cyan_primary" />
    </RadioGroup>

    <TextView
        android:id="@+id/helperText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/text_hologram_hi" />

    <com.scanwhirl.app.ui.CropView
        android:id="@+id/cropPreview"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/resize_target_label"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@color/text_hologram_hi" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/presetGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/v2t_quick_20"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/v2t_size_20" />

        <com.google.android.material.chip.Chip
            android:id="@+id/v2t_quick_50"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/v2t_size_50" />

        <com.google.android.material.chip.Chip
            android:id="@+id/v2t_quick_100"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/v2t_size_100" />

        <com.google.android.material.chip.Chip
            android:id="@+id/v2t_quick_200"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/v2t_size_200" />
    </com.google.android.material.chip.ChipGroup>

    <EditText
        android:id="@+id/editMaxSize"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_search_bar"
        android:hint="@string/resize_target_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:selectAllOnFocus="true"
        android:textColor="@color/text_hologram_hi"
        android:textColorHint="@color/text_hologram_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnMinMaxKb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:minHeight="48dp"
        android:paddingHorizontal="8dp"
        android:text="@string/resize_minmax"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@color/cyan_primary" />

    <LinearLayout
        android:id="@+id/sizeBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/editWidth"
            android:text="@string/resize_width"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/text_hologram_hi" />

        <EditText
            android:id="@+id/editWidth"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:importantForAutofill="no"
            android:inputType="number"
            android:paddingHorizontal="10dp"
            android:selectAllOnFocus="true"
            android:textColor="@color/text_hologram_hi"
            android:textColorHint="@color/text_hologram_dim"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:text="@string/resize_times"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/text_hologram_mid" />

        <EditText
            android:id="@+id/editHeight"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:importantForAutofill="no"
            android:inputType="number"
            android:paddingHorizontal="10dp"
            android:selectAllOnFocus="true"
            android:textColor="@color/text_hologram_hi"
            android:textColorHint="@color/text_hologram_dim"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/resize_px"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/text_hologram_hi" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnKeepOriginal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:minHeight="48dp"
        android:paddingHorizontal="8dp"
        android:text="@string/resize_keep_original"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@color/cyan_primary" />
</LinearLayout>
