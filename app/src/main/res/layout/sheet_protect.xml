<?xml version="1.0" encoding="utf-8"?>
<!-- L3 v2 Protect PDF sheet — mockup 05_protect_pdf (exact copy from src/05_protect_pdf.html):
     title + close, note, document chip, password + strength meter, confirm + check,
     AES-256 row, Remember in Vault, Protect & share / Save protected copy.
     Scrolls at large font scales. Binding: ui/protect/ProtectSheet.kt. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/protectSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_protect_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="30dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/protectTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/protect_sheet_title"
                android:textColor="@color/rv_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@id/protectClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/protect_close"
                android:padding="7dp"
                android:src="@drawable/ic_sw_close"
                app:tint="@color/rv_ink_2" />
        </LinearLayout>

        <TextView
            android:id="@+id/protectNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/protect_sheet_note"
            android:textColor="@color/rv_ink_2"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@id/protectDocChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_protect_docchip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@id/protectDocPages"
                android:layout_width="38dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_protect_thumb"
                android:gravity="center"
                android:textColor="@color/void_abyss"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@id/protectDocName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/rv_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@id/protectDocMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/rv_ink_3"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.03"
            android:text="@string/protect_label_password"
            android:textColor="@color/rv_ink_2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@id/protectPasswordRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_protect_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock_small"
                app:tint="@color/rv_ink_3" />

            <EditText
                android:id="@id/protectPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/protect_password_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:singleLine="true"
                android:textColor="@color/rv_ink"
                android:textColorHint="@color/rv_ink_2"
                android:textSize="16sp" />

            <ImageButton
                android:id="@id/protectPasswordShow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/protect_show_password"
                android:padding="10dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/rv_ink_3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <View
                android:id="@id/protectMeter1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_protect_meter"
                android:backgroundTint="@color/protect_meter_off" />

            <View
                android:id="@id/protectMeter2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_protect_meter"
                android:backgroundTint="@color/protect_meter_off" />

            <View
                android:id="@id/protectMeter3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_protect_meter"
                android:backgroundTint="@color/protect_meter_off" />

            <View
                android:id="@id/protectMeter4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_protect_meter"
                android:backgroundTint="@color/protect_meter_off" />
        </LinearLayout>

        <TextView
            android:id="@id/protectStrength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="5dp"
            android:paddingEnd="10dp"
            android:breakStrategy="simple"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.03"
            android:text="@string/protect_label_confirm"
            android:textColor="@color/rv_ink_2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_protect_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock_small"
                app:tint="@color/rv_ink_3" />

            <EditText
                android:id="@id/protectConfirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/protect_confirm_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:singleLine="true"
                android:textColor="@color/rv_ink"
                android:textColorHint="@color/rv_ink_2"
                android:textSize="16sp" />

            <ImageView
                android:id="@id/protectConfirmCheck"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/protect_confirm_ok"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/protect_ok" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_protect_info"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock_small"
                app:tint="@color/cyan_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/protect_aes_title"
                    android:textColor="@color/rv_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingEnd="12dp"
                    android:text="@string/protect_aes_note"
                    android:textColor="@color/rv_ink_2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@id/protectRememberRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/protect_remember_title"
                    android:textColor="@color/rv_ink"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/protect_remember_note"
                    android:textColor="@color/rv_ink_3"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@id/protectRemember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:checked="true" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@id/protectShare"
            style="@style/Widget.ScanWhirl.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:maxLines="2"
            android:layout_marginTop="18dp"
            android:text="@string/protect_action_share"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_lock_small"
            app:iconGravity="textStart"
            app:iconSize="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@id/protectSave"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:maxLines="2"
            android:text="@string/protect_action_save"
            android:textColor="@color/cyan_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
