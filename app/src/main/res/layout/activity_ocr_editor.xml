<?xml version="1.0" encoding="utf-8"?>
<!-- test26 P6 OCR Editor (§4.7): editable OCR text with per-page tabs,
     cleanup bar and Copy/Share/Save actions. adjustResize is declared in
     the manifest so the keyboard never covers the EditText. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:subtitleTextAppearance="@style/TextAppearance.ScanWhirl.ToolbarSubtitle"
        app:title="@string/ocr_editor_title"
        app:titleTextAppearance="@style/TextAppearance.ScanWhirl.ToolbarTitle"
        app:titleTextColor="@color/text_hologram_hi" />

    <!-- Page tabs: ChipGroup, only visible when there is more than one page. -->
    <HorizontalScrollView
        android:id="@+id/pageTabScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/pageTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </HorizontalScrollView>

    <!-- M06: honest recognition status (not read / unavailable / no text found),
         with Retry only when reading again can actually help. -->
    <LinearLayout
        android:id="@+id/ocrStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:background="@color/rv_surface_2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ocrStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/rv_warn"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOcrRetry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/ocr_retry"
            android:visibility="gone" />
    </LinearLayout>

    <!-- v2 UI: 08_text_ocr — Page / Text switch. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_sw_segment"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/ocrModePage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/ocr_mode_page"
            android:textColor="@color/text_hologram_dim"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ocrModeText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_sw_segment_on"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/ocr_mode_text"
            android:textColor="@color/cyan_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Page view: the scan itself while the text pane is hidden. -->
    <FrameLayout
        android:id="@+id/ocrPagePane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ocrPageImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/ocr_mode_page"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/ocrPagePaneNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="18dp"
            android:text="@string/ocr_page_pane_note"
            android:textColor="@color/text_hologram_dim"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <EditText
        android:id="@+id/editText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card"
        android:fontFamily="@font/manrope"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:minLines="3"
        android:overScrollMode="always"
        android:padding="12dp"
        android:scrollbarStyle="outsideInset"
        android:textColor="@color/text_hologram_hi"
        android:textColorHint="@color/text_hologram_dim"
        android:textSize="14sp" />

    <!-- Word count + Undo/Redo row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/wordCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_undo"
            android:contentDescription="@string/ocr_undo_desc"
            app:tint="@color/text_hologram_hi"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_redo"
            android:contentDescription="@string/ocr_redo_desc"
            app:tint="@color/text_hologram_hi"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Cleanup bar: Join lines · Fix spaces · Remove gaps. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJoinLines"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:paddingHorizontal="8dp"
            android:textSize="12sp"
            android:maxLines="2"
            android:text="@string/ocr_join_lines" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFixSpaces"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:paddingHorizontal="8dp"
            android:textSize="12sp"
            android:maxLines="2"
            android:text="@string/ocr_fix_spaces" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemoveGaps"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:paddingHorizontal="8dp"
            android:textSize="12sp"
            android:maxLines="2"
            android:text="@string/ocr_remove_gaps" />
    </LinearLayout>

    <!-- v2 UI: 08_text_ocr — Copy · Share · Save · To Word. Horizontal scroll so
         a 320dp phone at 200% text never squeezes a label (the mockup wraps). -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopy"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/ocr_copy_btn" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="64dp"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/ocr_share_btn" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="64dp"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/ocr_save_btn" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToWord"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="64dp"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/ocr_to_word_pro"
                android:textColor="@color/gold_pro_primary" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- v2 UI: 08_text_ocr — the honest footer. -->
    <TextView
        android:id="@+id/ocrFootNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:drawableStart="@drawable/ic_sym_check_circle"
        android:drawablePadding="6dp"
        android:drawableTint="@color/ok_green"
        android:fontFamily="@font/manrope"
        android:text="@string/ocr_foot_note"
        android:textColor="@color/text_hologram_dim"
        android:textSize="11.5sp"
        android:textStyle="bold" />

</LinearLayout>
