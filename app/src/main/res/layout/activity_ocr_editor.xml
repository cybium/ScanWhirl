<?xml version="1.0" encoding="utf-8"?>
<!-- test26 P6 OCR Editor (§4.7): editable OCR text with per-page tabs,
     cleanup bar and Copy/Share/Save actions. adjustResize is declared in
     the manifest so the keyboard never covers the EditText. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:subtitleTextAppearance="@style/TextAppearance.ScanWhirl.ToolbarSubtitle"
        app:title="@string/ocr_editor_title"
        app:titleTextAppearance="@style/TextAppearance.ScanWhirl.ToolbarTitle"
        app:titleTextColor="@color/text_hologram_hi" />

    <!-- Page tabs: ChipGroup, only visible when there is more than one page. -->
    <HorizontalScrollView
        android:id="@+id/pageTabScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/pageTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </HorizontalScrollView>

    <!-- M06: honest recognition status (not read / unavailable / no text found),
         with Retry only when reading again can actually help. -->
    <LinearLayout
        android:id="@+id/ocrStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:background="@color/rv_surface_2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ocrStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/rv_warn"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOcrRetry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/ocr_retry"
            android:visibility="gone" />
    </LinearLayout>

    <!-- v2 UI: 08_text_ocr — Page / Text switch, language chip on the right. -->
    <LinearLayout
        android:id="@+id/ocrSegmentRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sw_segment"
            android:orientation="horizontal"
            android:padding="4dp">

        <TextView
            android:id="@+id/ocrModePage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/ocr_mode_page"
            android:textColor="@color/text_hologram_dim"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ocrModeText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_sw_segment_on"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/ocr_mode_text"
            android:textColor="@color/cyan_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ocrLangHost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Page view: the scan itself while the text pane is hidden. -->
    <FrameLayout
        android:id="@+id/ocrPagePane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ocrPageImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/ocr_mode_page"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <!-- v2 UI: 08_text_ocr — recognised line boxes over the page image. -->
        <com.scanwhirl.app.ui.OcrLineOverlay
            android:id="@+id/ocrPageOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp" />

        <TextView
            android:id="@+id/ocrPagePaneNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="18dp"
            android:text="@string/ocr_page_pane_note"
            android:textColor="@color/text_hologram_dim"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <EditText
        android:id="@+id/editText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card"
        android:fontFamily="@font/manrope"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:minLines="3"
        android:overScrollMode="always"
        android:padding="12dp"
        android:scrollbarStyle="outsideInset"
        android:textColor="@color/text_hologram_hi"
        android:textColorHint="@color/text_hologram_dim"
        android:textSize="14sp" />

    <!-- v2 UI: 08_text_ocr — Undo and Redo first, then the word count. Edit mode only:
         read-first hides editing controls until the person chooses Edit text. -->
    <LinearLayout
        android:id="@+id/ocrEditBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ocr_undo_desc"
            android:src="@drawable/ic_sym_undo"
            app:tint="@color/text_hologram_hi" />

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ocr_redo_desc"
            android:src="@drawable/ic_sym_redo"
            app:tint="@color/text_hologram_hi" />

        <TextView
            android:id="@+id/wordCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- W5 read-first: page indicator plus the read-mode actions. Read mode offers
         Copy all pages and Edit text; edit mode swaps in Save edits and Done. -->
    <LinearLayout
        android:id="@+id/ocrReadRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/ocrPageIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textColor="@color/text_hologram_mid"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyAll"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:paddingHorizontal="6dp"
            android:text="@string/ocr_w5_copy_all_pages"
            android:textColor="@color/cyan_primary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEdits"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:paddingHorizontal="6dp"
            android:text="@string/ocr_w5_save_edits"
            android:textColor="@color/cyan_primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditText"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:paddingHorizontal="6dp"
            android:text="@string/ocr_w5_edit_text"
            android:textColor="@color/cyan_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- W5: the .txt write failed but the library text is kept; Retry retries the write. -->
    <LinearLayout
        android:id="@+id/ocrTxtFailure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="4dp"
        android:background="@color/rv_surface_2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ocrTxtFailureText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/rv_warn"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTxtRetry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/ocr_w5_retry_txt" />
    </LinearLayout>

    <!-- v2 UI: 08_text_ocr — Copy all · Share text · Save .txt · To Word (chips).
         Owner F8: roomy chip rows: 8dp gaps inside a row, 12dp between the rows (in code). -->
    <LinearLayout
        android:id="@+id/ocrActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp" />

    <!-- v2 UI: 08_text_ocr — the honest footer, one short line. -->
    <TextView
        android:id="@+id/ocrFootNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:drawableStart="@drawable/ic_sym_check_circle"
        android:drawablePadding="6dp"
        android:drawableTint="@color/ok_green"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:maxLines="1"
        android:text="@string/ocr_foot_note"
        android:textColor="@color/text_hologram_dim"
        android:textSize="11.5sp"
        android:textStyle="bold" />

</LinearLayout>
