<?xml version="1.0" encoding="utf-8"?>
<!-- Review slice 1: one numbered filmstrip cell (52x70dp page, >= 48dp target).
     The current page wears the accent ring and an accent number badge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="56dp"
    android:layout_height="74dp"
    android:layout_marginHorizontal="3dp"
    android:background="@drawable/bg_rv_film"
    android:clickable="true"
    android:focusable="true"
    android:padding="3dp">

    <ImageView
        android:id="@+id/filmThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/filmNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:background="@drawable/bg_rv_num"
        android:importantForAccessibility="no"
        android:minWidth="20dp"
        android:gravity="center"
        android:paddingHorizontal="4dp"
        android:textColor="@color/rv_ink"
        android:textSize="11sp"
        android:textStyle="bold" />
</FrameLayout>
