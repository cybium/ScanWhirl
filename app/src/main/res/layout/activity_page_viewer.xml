<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        android:src="@drawable/ic_close"
        app:tint="@color/tok_text" />

    <TextView
        android:id="@+id/pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="#CC000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <!-- test26 T5.1 (§4.6/§5.4): icon-over-label glass dock.
         F1-FIT (atlas 2026-11-20): four equal cells forced "Rotat / e" and
         "Delet / e" at 200 % text on a 320 dp phone. The row is now a
         FlowRowLayout: four evenly spread items while every label fits its
         share, otherwise it wraps to two rows and each item keeps the width
         its own label asks for. Heights stay wrap_content (minHeight 64dp). -->
    <com.scanwhirl.app.ui.FlowRowLayout
        android:id="@+id/pageDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="8dp"
        android:background="@drawable/bg_dock_glass"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRotateRight"
            style="@style/Widget.ScanWhirl.Button.DockItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:minHeight="64dp"
            android:minWidth="0dp"
            android:maxLines="2"
            android:paddingHorizontal="4dp"
            android:text="@string/action_rotate"
            app:icon="@drawable/ic_rotate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrop"
            style="@style/Widget.ScanWhirl.Button.DockItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:minHeight="64dp"
            android:minWidth="0dp"
            android:maxLines="2"
            android:paddingHorizontal="4dp"
            android:text="@string/crop_action"
            app:icon="@drawable/ic_crop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilter"
            style="@style/Widget.ScanWhirl.Button.DockItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:minHeight="64dp"
            android:minWidth="0dp"
            android:maxLines="2"
            android:paddingHorizontal="4dp"
            android:text="@string/filter_action"
            app:icon="@drawable/ic_filter" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Widget.ScanWhirl.Button.DockItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:minHeight="64dp"
            android:minWidth="0dp"
            android:maxLines="2"
            android:paddingHorizontal="4dp"
            android:text="@string/delete"
            app:icon="@drawable/ic_delete" />
    </com.scanwhirl.app.ui.FlowRowLayout>

    <FrameLayout
        android:id="@+id/cropOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone">

        <com.scanwhirl.app.ui.CropView
            android:id="@+id/cropView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <HorizontalScrollView
            android:id="@+id/cropPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="56dp"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingEnd="28dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipCropGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="24dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCropFree"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/crop_size_free" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCropPassport"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/crop_size_passport" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCropIdCard"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/crop_size_id" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCropVisa"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/crop_size_visa" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelCrop"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@android:string/cancel"
                android:textColor="#FFFFFFFF"
                app:icon="@drawable/ic_close"
                app:iconTint="#FFFFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyCrop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/crop_apply"
                app:icon="@drawable/ic_crop" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
