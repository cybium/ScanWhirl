<?xml version="1.0" encoding="utf-8"?>
<!-- test25 Phase 5B: glass card face + page identity. The card's background drawable is set in
     code (PageGridView.VH) because MaterialCardView silently drops XML android:background.

     v2 UI: 07_reader_dock — the page number is a quiet label UNDER the paper, centred, never a
     chip drawn over the page image (owner check 2026-11-18). Selection and drag are untouched:
     the tick is still a 48 dp wrapper in the paper's top-right corner. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Council §4 / UI_100 §G1.10: a page cell is the dark sw_canvas with an
             8dp inset and a 1dp page edge. fitCenter + pad keeps the white sheet
             whole instead of centre-cropping it against the card edge. -->
        <com.scanwhirl.app.ui.pagegrid.AspectRatioLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/sw_cc_canvas"
            android:foreground="@drawable/bg_canvas_page_edge"
            android:padding="8dp">

            <ImageView
                android:id="@+id/pageThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_document" />

            <!-- Review slice 1: current-page ring over the thumb (gone unless Review sets it). -->
            <View
                android:id="@+id/currentRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fg_rv_current_ring"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <!-- Round selection check: visible only in selection mode (owner revision).
                 The 48dp wrapper is the touch target; the 28dp circle is the visual. -->
            <FrameLayout
                android:id="@+id/checkSelectTouch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:clickable="true"
                android:contentDescription="@string/review_select_page"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/checkSelect"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_page_check"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_sw_check"
                    app:tint="#FFFFFFFF" />
            </FrameLayout>
        </com.scanwhirl.app.ui.pagegrid.AspectRatioLayout>

        <TextView
            android:id="@+id/pageNum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_hologram_mid"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
