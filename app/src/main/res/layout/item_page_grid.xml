<?xml version="1.0" encoding="utf-8"?>
<!-- test25 Phase 5B: glass card face + chip-void page badge. The card's
     background drawable is set in code (PageGridView.VH) because
     MaterialCardView silently drops XML android:background — see plan. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="0dp">

    <com.scanwhirl.app.ui.pagegrid.AspectRatioLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/pageThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceVariant"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_document" />

        <!-- Review slice 1: current-page ring over the thumb (gone unless Review sets it). -->
        <View
            android:id="@+id/currentRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fg_rv_current_ring"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pageNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_chip_void"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <!-- Round selection check: visible only in selection mode (owner revision).
             The 48dp wrapper is the touch target; the 28dp circle is the visual. -->
        <FrameLayout
            android:id="@+id/checkSelectTouch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:clickable="true"
            android:contentDescription="@string/review_select_page"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/checkSelect"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_page_check"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sw_check"
                app:tint="#FFFFFFFF" />
        </FrameLayout>
    </com.scanwhirl.app.ui.pagegrid.AspectRatioLayout>
</com.google.android.material.card.MaterialCardView>
