<?xml version="1.0" encoding="utf-8"?>
<!--
  UI-B3 (#7) + W2: the Compress setup sheet. Two explicit aims ("Choose quality" / "Aim for a
  file size"), the existing quality estimates, and the exact-size field with a hint that stays
  put and an inline error. Title and options scroll above SwSheet's pinned, wrapping
  Compress/Cancel footer, including at 200% type with the keyboard open.

  W2 (lane 2): the sheet opens instantly and names the job before any estimate runs — the exact
  source name, its page count and size, and its real first page only for an ordinary document
  (locked/Vault/PDF-only documents keep the privacy placeholder). The estimates then fill in
  row by row underneath, and the target field is usable from the first frame.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compressScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- W2: which document this sheet is about, from the first frame. -->
        <LinearLayout
            android:id="@+id/compressSourceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <FrameLayout
                android:id="@+id/compressSourceThumbFrame"
                android:layout_width="56dp"
                android:layout_height="78dp"
                android:importantForAccessibility="no">

                <ImageView
                    android:id="@+id/compressSourceThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_thumb_paper" />

                <ImageView
                    android:id="@+id/compressSourceThumbGlyph"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/compressSourceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_hologram_hi"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/compressSourceMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_hologram_mid"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <RadioGroup
            android:id="@+id/compressModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/compressModeQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingVertical="8dp"
                android:text="@string/compress_mode_quality"
                android:textColor="@color/text_hologram_hi"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/compressModeTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingVertical="8dp"
                android:text="@string/compress_mode_target"
                android:textColor="@color/text_hologram_hi"
                android:textSize="15sp" />
        </RadioGroup>

        <!-- The quality estimates, rebuilt in code from the measured samples. -->
        <RadioGroup
            android:id="@+id/levelGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/compressTargetBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/editCompressTarget"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:hint="@string/resize_target_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/text_hologram_hi"
                android:textColorHint="@color/text_hologram_dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/compressTargetHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/compress_target_help"
                android:textColor="@color/text_hologram_mid"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/compressTargetError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/laser_danger"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
