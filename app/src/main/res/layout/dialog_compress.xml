<?xml version="1.0" encoding="utf-8"?>
<!--
  UI-B3 (#7) + W2: the Compress setup sheet. Two explicit aims ("Choose quality" / "Aim for a
  file size"), the existing quality estimates, and the exact-size field with a hint that stays
  put and an inline error. Title and options scroll above SwSheet's pinned Compress action;
  this is a non-destructive sheet, so the X is the only dismissal (no duplicate Cancel).

  W2 (lane 2): the sheet opens instantly and names the job before any estimate runs — the exact
  source name, its page count and size, and its real first page only for an ordinary document
  (locked/Vault/PDF-only documents keep the privacy placeholder). The estimates then fill in
  row by row underneath, and the target field is usable from the first frame.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/compressScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- W2: which document this sheet is about, from the first frame. -->
        <LinearLayout
            android:id="@+id/compressSourceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <FrameLayout
                android:id="@+id/compressSourceThumbFrame"
                android:layout_width="56dp"
                android:layout_height="78dp"
                android:background="@color/sw_cc_canvas"
                android:foreground="@drawable/bg_canvas_page_edge"
                android:importantForAccessibility="no">

                <ImageView
                    android:id="@+id/compressSourceThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_thumb_paper" />

                <ImageView
                    android:id="@+id/compressSourceThumbGlyph"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/compressSourceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/sw_sh2_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- COPY_DIET §3: page count and size are P; the code spans them in P14.
                     Only the separator/date may stay S. -->
                <TextView
                    android:id="@+id/compressSourceMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/sw_sh2_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <RadioGroup
            android:id="@+id/compressModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/compressModeQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingVertical="8dp"
                android:text="@string/compress_mode_quality"
                android:textColor="@color/sw_sh2_text_primary"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/compressModeTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingVertical="8dp"
                android:text="@string/compress_mode_target"
                android:textColor="@color/sw_sh2_text_primary"
                android:textSize="16sp" />
        </RadioGroup>

        <!-- The quality estimates, rebuilt in code from the measured samples. -->
        <RadioGroup
            android:id="@+id/levelGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/compressTargetBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- COPY_DIET: the "Maximum file size" radio above is the one persistent
                 label. The four free decimal-KB presets sit in a 2x2 grid and keep the
                 same outlined shape and readable label in both states. -->
            <LinearLayout
                android:id="@+id/v2t_quick_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/v2t_quick_20"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:minHeight="48dp"
                        android:textColor="@color/sw_sh2_text_primary"
                        android:textSize="14sp"
                        android:text="@string/v2t_size_20"
                        app:chipBackgroundColor="@color/sw_chip_fill"
                        app:chipStrokeColor="@color/chip_in_text_stroke"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/v2t_quick_50"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:minHeight="48dp"
                        android:textColor="@color/sw_sh2_text_primary"
                        android:textSize="14sp"
                        android:text="@string/v2t_size_50"
                        app:chipBackgroundColor="@color/sw_chip_fill"
                        app:chipStrokeColor="@color/chip_in_text_stroke"
                        app:chipStrokeWidth="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/v2t_quick_100"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:minHeight="48dp"
                        android:textColor="@color/sw_sh2_text_primary"
                        android:textSize="14sp"
                        android:text="@string/v2t_size_100"
                        app:chipBackgroundColor="@color/sw_chip_fill"
                        app:chipStrokeColor="@color/chip_in_text_stroke"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/v2t_quick_200"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:minHeight="48dp"
                        android:textColor="@color/sw_sh2_text_primary"
                        android:textSize="14sp"
                        android:text="@string/v2t_size_200"
                        app:chipBackgroundColor="@color/sw_chip_fill"
                        app:chipStrokeColor="@color/chip_in_text_stroke"
                        app:chipStrokeWidth="1dp" />
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/editCompressTarget"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:hint="@string/compress_target_placeholder"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/sw_sh2_text_primary"
                android:textColorHint="@color/sw_sh2_text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/compressTargetHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/compress_target_help"
                android:textColor="@color/sw_sh2_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/compressTargetError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/sw_sh2_text_danger"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
