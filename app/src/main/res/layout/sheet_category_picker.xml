<?xml version="1.0" encoding="utf-8"?>
<!-- test26 T4.2 (§4.x): the category picker sheet — a title plus a
     code-built row per category (five coloured rows, + Unsorted only when it
     is the current value), because the Unsorted row is conditional.
     Driven by CategoryPickerSheet.show() for T4.3, T4.4 and T4.6. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_glass"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="20dp"
    android:paddingEnd="12dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/pickerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.04"
        android:text="@string/category_picker_title"
        android:textColor="@color/text_hologram_hi"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/pickerRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
