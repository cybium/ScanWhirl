<?xml version="1.0" encoding="utf-8"?>
<!-- L5 Stamp editor (70 §3 Edit & sign; product spec §3.7). Page view, a tool row along
     the bottom, drag/resize/rotate handles, undo/redo and Save as a new copy.
     v2 tokens: void_abyss, glass_surface*, cyan_primary and dimens_v2; the buttons are
     painted from SwStyle in StampEditorActivity so they match the kit's sheets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_abyss"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/void_abyss"
        android:foreground="@drawable/bg_appbar_hairline">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/text_hologram_hi"
            app:title="@string/stamp_title"
            app:titleTextColor="@color/text_hologram_hi" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/sw_space_2">

        <com.scanwhirl.app.ui.stamp.StampCanvasView
            android:id="@+id/canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/pageNav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/sw_space_2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/sw_space_1">

            <TextView
                android:id="@+id/prevPage"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:contentDescription="@string/stamp_prev_page"
                android:gravity="center"
                android:text="@string/stamp_prev_symbol"
                android:textColor="@color/cyan_primary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/pageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:gravity="center"
                android:textColor="@color/text_hologram_mid"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/nextPage"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:contentDescription="@string/stamp_next_page"
                android:gravity="center"
                android:text="@string/stamp_next_symbol"
                android:textColor="@color/cyan_primary"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="@dimen/sw_space_4"
            android:layout_marginTop="@dimen/sw_space_2"
            android:gravity="center"
            android:paddingHorizontal="@dimen/sw_space_3"
            android:paddingVertical="6dp"
            android:textColor="@color/text_hologram_mid"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sw_cyan_hair" />

    <HorizontalScrollView
        android:id="@+id/toolScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/void_abyss"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingEnd="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/stampToolRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/sw_space_2"
            android:paddingVertical="@dimen/sw_space_1" />
    </HorizontalScrollView>

    <!-- Audit item 8: the hint gets its own line under the two action labels,
         so Hindi (2.4x English) never squeezes it into ~80dp. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/sw_space_3"
        android:paddingTop="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/deleteMark"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:enabled="false"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingHorizontal="@dimen/sw_space_3"
                android:text="@string/stamp_delete"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/findRedactions"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingHorizontal="@dimen/sw_space_2"
                android:text="@string/find_button"
                android:textColor="@color/cyan_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/selectionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stamp_no_selection"
            android:textColor="@color/text_hologram_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/sw_space_3">

        <TextView
            android:id="@+id/undo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/sw_space_2"
            android:enabled="false"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingHorizontal="@dimen/sw_space_3"
            android:text="@string/stamp_undo"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/redo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:enabled="false"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingHorizontal="@dimen/sw_space_3"
            android:text="@string/stamp_redo"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/saveCopy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:gravity="center"
            android:minHeight="@dimen/sw_btn_height"
            android:paddingVertical="8dp"
            android:text="@string/stamp_save_copy"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
