<?xml version="1.0" encoding="utf-8"?>
<!-- L5 Stamp editor (70 §3 Edit & sign; product spec §3.7). Page view, a tool row along
     the bottom, drag/resize/rotate handles, undo/redo and Save as a new copy. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rv_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rv_bg"
        android:foreground="@drawable/bg_appbar_hairline">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/rv_ink"
            app:title="@string/stamp_title"
            app:titleTextColor="@color/rv_ink" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp">

        <com.scanwhirl.app.ui.stamp.StampCanvasView
            android:id="@+id/canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/pageNav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_dock_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/prevPage"
                style="@style/Widget.ScanWhirl.Button.Dock"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="@string/stamp_prev_page"
                android:minWidth="44dp"
                android:text="@string/stamp_prev_symbol"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/pageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:gravity="center"
                android:textColor="@color/rv_ink_2"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextPage"
                style="@style/Widget.ScanWhirl.Button.Dock"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:contentDescription="@string/stamp_next_page"
                android:minWidth="44dp"
                android:text="@string/stamp_next_symbol"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_void"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/rv_ink_2"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/toolScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rv_bg"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolSignature"
                style="@style/Widget.ScanWhirl.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:minHeight="44dp"
                android:text="@string/stamp_tool_signature" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolText"
                style="@style/Widget.ScanWhirl.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:minHeight="44dp"
                android:text="@string/stamp_tool_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolDraw"
                style="@style/Widget.ScanWhirl.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:minHeight="44dp"
                android:text="@string/stamp_tool_draw" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolHighlight"
                style="@style/Widget.ScanWhirl.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:minHeight="44dp"
                android:text="@string/stamp_tool_highlight" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolWatermark"
                style="@style/Widget.ScanWhirl.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:minHeight="44dp"
                android:text="@string/stamp_tool_watermark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolPageNumbers"
                style="@style/Widget.ScanWhirl.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:minHeight="44dp"
                android:text="@string/stamp_tool_page_numbers" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolStamp"
                style="@style/Widget.ScanWhirl.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:minHeight="44dp"
                android:text="@string/stamp_tool_stamp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolRedact"
                style="@style/Widget.ScanWhirl.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:minHeight="44dp"
                android:text="@string/stamp_tool_redact" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolSuggest"
                style="@style/Widget.ScanWhirl.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:text="@string/stamp_suggest" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteMark"
            style="@style/Widget.ScanWhirl.Button.Danger"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:enabled="false"
            android:minHeight="40dp"
            android:text="@string/stamp_delete" />

        <TextView
            android:id="@+id/selectionHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/stamp_no_selection"
            android:textColor="@color/rv_ink_3"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/undo"
            style="@style/Widget.ScanWhirl.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:enabled="false"
            android:minWidth="72dp"
            android:text="@string/stamp_undo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/redo"
            style="@style/Widget.ScanWhirl.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:enabled="false"
            android:minWidth="72dp"
            android:text="@string/stamp_redo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveCopy"
            style="@style/Widget.ScanWhirl.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/stamp_save_copy" />
    </LinearLayout>
</LinearLayout>
