<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- test25 Phase 5D: cyan hairline over the existing sf_appbar (foreground
         keeps the current background). -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sf_appbar"
        android:foreground="@drawable/bg_appbar_hairline">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/trash_navigate_up"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/result_title"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <ImageView
                    android:id="@+id/resultPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:background="#FFFFFFFF"
                    android:contentDescription="@null"
                    android:maxHeight="420dp"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/resultStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/resultWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorError"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- test25 Phase 5D: inset floating glass dock.
         F1-FIT (atlas 2026-11-20): at 200 % text the CTA broke into
         "Save to / Downlo / ads" because both buttons shared one row. The row
         is a FlowRowLayout: side by side while both labels fit, otherwise one
         full-width action per row. The scroll above it keeps 24 dp of bottom
         padding so no line ends flush against this fixed bar. -->
    <com.scanwhirl.app.ui.FlowRowLayout
        android:id="@+id/exportDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:background="@drawable/bg_dock_glass"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareResult"
            style="@style/Widget.ScanWhirl.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="2dp"
            android:text="@string/result_share"
            app:icon="@drawable/ic_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="2dp"
            android:text="@string/result_save_downloads"
            app:icon="@drawable/ic_download" />
    </com.scanwhirl.app.ui.FlowRowLayout>
</LinearLayout>
