<?xml version="1.0" encoding="utf-8"?>
<!-- test26 T4.4: the Quick Sort sheet (plan §4.8) —
     "Quick sort  N of M" header with the X close button top-right
     (Rev 4 §3D: closing mid-queue just closes, no confirmation), a big
     thumbnail + document line, then the five category chips and Skip.
     Chips are added in code (Widget.ScanWhirl.Chip, tag = stored value;
     the Skip chip is tagged "skip"). The All-sorted banner replaces the
     queue UI when the queue empties. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_glass"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/qsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="@string/quick_sort"
            android:textColor="@color/text_hologram_hi"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qsProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:maxLines="1"
            android:textColor="@color/cyan_dim"
            android:textSize="12sp" />

        <!-- Rev 4 §3D: the visible button equivalent for swipe-down dismiss
             (R7); 48dp target (R6). -->
        <ImageButton
            android:id="@+id/qsClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <ImageView
        android:id="@+id/qsThumb"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@drawable/ic_document" />

    <TextView
        android:id="@+id/qsDoc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_hologram_hi"
        android:textSize="14sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/qsChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="6dp" />

    <TextView
        android:id="@+id/qsDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:text="@string/all_sorted"
        android:textColor="@color/cyan_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
