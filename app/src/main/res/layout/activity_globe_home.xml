<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space">

    <!-- Holographic Earth + rings (custom Canvas, no OpenGL/3D). -->
    <com.scanwhirl.app.ui.globe.HolographicEarthView
        android:id="@+id/globeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        test25: scrim behind the HUD so the title/status/buttons stay legible
        over the star field (gradient fades downward into space).
    -->
    <View
        android:id="@+id/hudScrim"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_hud_scrim" />

    <!-- HUD header: title + status readout + search/List/Settings entries. -->
    <LinearLayout
        android:id="@+id/globeHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/globeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/text_hologram_hi"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/globeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.08"
                android:text="@string/globe_status_empty"
                android:textColor="@color/text_hologram_dim"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnGlobeSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_round_btn"
            android:contentDescription="@string/globe_search_open"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            app:tint="@color/cyan_primary" />

        <ImageButton
            android:id="@+id/btnGlobeList"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_round_btn"
            android:contentDescription="@string/btn_list"
            android:padding="8dp"
            android:src="@drawable/ic_list"
            app:tint="@color/cyan_primary" />

        <!-- D5: gear → SettingsActivity. -->
        <ImageButton
            android:id="@+id/btnGlobeSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_round_btn"
            android:contentDescription="@string/btn_settings"
            android:padding="8dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/cyan_primary" />
    </LinearLayout>

    <!-- Pull-down search panel (hidden until pulled / tapped). -->
    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#E6050C16"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="76dp"
        android:paddingBottom="14dp"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="#00F0FF" />

            <EditText
                android:id="@+id/globeSearchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/globe_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:selectAllOnFocus="false"
                android:singleLine="true"
                android:textColor="#E2F8FF"
                android:textColorHint="#8CB8E180"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/globeMatchCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#D900F0FF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSearchDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp"
                android:text="@string/close"
                android:textColor="#CCD5E1FF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty state. -->
    <LinearLayout
        android:id="@+id/globeEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/globeEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/globe_empty_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="#E2F8FF" />

        <TextView
            android:id="@+id/globeEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/globe_empty_sub"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="#8CB8E1" />
    </LinearLayout>

    <!--
        Bottom stack (test25): gesture hint pill → orbit dock (five category
        chips that focus a ring) → scan FAB with two static pulse rings.
        The canvas no longer draws the hint; globeHint mirrors
        globeView.hintText. Pulse motion is Phase 4 (SwMotion-gated).
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/globeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_search_bar"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="@string/globe_hint_home"
            android:textColor="@color/cyan_primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Orbit dock: tap a chip to focus its ring, tap again to clear. -->
        <LinearLayout
            android:id="@+id/globeDock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/globeChipStudy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_chip_void"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="@string/cat_label_study"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/globeChipReceipts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_chip_void"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="@string/cat_label_receipts"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/globeChipIds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_chip_void"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="@string/cat_label_ids"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/globeChipForms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_chip_void"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="@string/cat_label_forms"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/globeChipOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_chip_void"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="@string/cat_label_other"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Primary action: scan with concentric rings + "TAP TO SCAN" label. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_fab_orbital"
                android:clipChildren="false">

                <View
                    android:id="@+id/fabPulse1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.55"
                    android:background="@drawable/bg_fab_pulse" />

                <View
                    android:id="@+id/fabPulse2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.30"
                    android:background="@drawable/bg_fab_pulse" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabGlobeScan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:contentDescription="@string/scan"
                    android:src="@drawable/ic_camera"
                    app:backgroundTint="@color/glass_surface_raised"
                    app:elevation="0dp"
                    app:hoveredFocusedTranslationZ="0dp"
                    app:pressedTranslationZ="0dp"
                    app:tint="@color/cyan_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.08"
                android:text="@string/scan_tap_prompt"
                android:textColor="@color/cyan_primary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!--
        test25 Phase 4: radial reveal wash for the scan launch — expands from
        the FAB over the globe, then the Shelf warps in on top. Additive id
        (not on the locked list); hidden until SwTransitions shows it, and only
        ever shown when SwMotion.ambientAllowed.
    -->
    <View
        android:id="@+id/scanReveal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_space"
        android:visibility="gone" />
</FrameLayout>
