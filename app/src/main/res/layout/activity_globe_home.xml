<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space">

    <!-- Holographic Earth + rings (custom Canvas, no OpenGL/3D). -->
    <com.scanwhirl.app.ui.globe.HolographicEarthView
        android:id="@+id/globeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD header: name + search entry. -->
    <LinearLayout
        android:id="@+id/globeHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@color/text_hologram_hi"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnGlobeSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_round_btn"
            android:contentDescription="@string/globe_search_open"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            app:tint="@color/cyan_primary" />
    </LinearLayout>

    <!-- Pull-down search panel (hidden until pulled / tapped). -->
    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#E6050C16"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="64dp"
        android:paddingBottom="14dp"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="#00F0FF" />

            <EditText
                android:id="@+id/globeSearchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/globe_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:selectAllOnFocus="false"
                android:singleLine="true"
                android:textColor="#E2F8FF"
                android:textColorHint="#8CB8E180"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/globeMatchCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#D900F0FF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSearchDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp"
                android:text="@string/close"
                android:textColor="#CCD5E1FF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty state. -->
    <LinearLayout
        android:id="@+id/globeEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/globeEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="#E2F8FF" />

        <TextView
            android:id="@+id/globeEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/empty_subtitle"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="#8CB8E1" />
    </LinearLayout>

    <!-- Primary action: scan with double cyan concentric ring + "TAP TO SCAN" label. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_fab_outer_ring">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabGlobeScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@string/scan"
                android:src="@drawable/ic_camera"
                app:backgroundTint="@color/glass_surface_raised"
                app:elevation="0dp"
                app:hoveredFocusedTranslationZ="0dp"
                app:pressedTranslationZ="0dp"
                app:tint="@color/cyan_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.08"
            android:text="@string/scan_tap_prompt"
            android:textColor="@color/cyan_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
