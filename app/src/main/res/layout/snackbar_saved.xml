<?xml version="1.0" encoding="utf-8"?>
<!-- T4.7: Snackbar content with Open + Undo (Material allows only one action
     button, so both live here as a custom view inside the snackbar).
     M06 (found on device): Material 3 draws snackbars on colorSurfaceInverse, so
     text and actions use the inverse colours like the stock snackbar does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingTop="6dp"
    android:paddingRight="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/snackMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="?attr/colorOnSurfaceInverse"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/snackOpen"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/open"
        android:textColor="?attr/colorPrimaryInverse" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/snackUndo"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/undo"
        android:textColor="?attr/colorPrimaryInverse" />
</LinearLayout>
