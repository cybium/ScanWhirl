<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pdf_bg"
    android:orientation="vertical">

    <!-- test25 Phase 5D: cyan hairline over the pdf_toolbar bar (foreground
         keeps the current background). -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pdf_toolbar"
        android:foreground="@drawable/bg_appbar_hairline">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/text_hologram_hi"
            app:titleTextColor="@color/text_hologram_hi" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pdfPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pdf_bg"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="92dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/pdfPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="#CC000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <!-- v2 UI: 07_reader_dock — the dock floats over the page, so it never
             takes height from the PDF (the Find panel below keeps its room). -->
        <include
            layout="@layout/view_reader_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp" />
    </FrameLayout>

    <!-- Retrieval slice 5: Find in the recognised text. Docked under the pages (never
         over them), height-capped and scrollable so 200% text cannot squeeze the PDF
         away. Text evidence only: the page image is never marked. -->
    <com.scanwhirl.app.ui.CappedScrollView
        android:id="@+id/findPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_find_panel"
        android:fillViewport="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/findInputRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sw_search_pages"
                    app:tint="@color/rv_ink_2" />

                <EditText
                    android:id="@+id/findInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/reader_find_hint"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:saveEnabled="false"
                    android:textColor="@color/rv_ink"
                    android:textColorHint="@color/rv_ink_3"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnFindClose"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/reader_find_close"
                    android:src="@drawable/ic_sw_close"
                    app:tint="@color/rv_ink_2" />
            </LinearLayout>

            <TextView
                android:id="@+id/findStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:accessibilityLiveRegion="polite"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/rv_ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/findExcerpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_find_excerpt"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:maxLines="3"
                android:minHeight="48dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:textColor="@color/rv_ink_2"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Flow row: Previous / Next stay side by side, and wrap at 200% text. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/findNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="6dp"
                app:singleLine="false">

                <TextView
                    android:id="@+id/btnFindPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_find_button"
                    android:clickable="true"
                    android:contentDescription="@string/reader_find_prev_desc"
                    android:drawableStart="@drawable/ic_sw_earlier"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/rv_accent"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="16dp"
                    android:text="@string/reader_find_prev"
                    android:textColor="@color/rv_accent"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnFindNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_find_button"
                    android:clickable="true"
                    android:contentDescription="@string/reader_find_next_desc"
                    android:drawableEnd="@drawable/ic_sw_later"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/rv_accent"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp"
                    android:text="@string/reader_find_next"
                    android:textColor="@color/rv_accent"
                    android:textSize="14sp" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/findNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="8dp"
                android:text="@string/reader_find_note"
                android:textColor="@color/rv_ink_3"
                android:textSize="12sp" />
        </LinearLayout>
    </com.scanwhirl.app.ui.CappedScrollView>

    <FrameLayout
        android:id="@+id/zoomOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF1B1B1B"
        android:visibility="gone">

        <com.scanwhirl.app.ui.ZoomableImageView
            android:id="@+id/zoomImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null" />

        <ImageButton
            android:id="@+id/btnZoomClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFFFF" />
    </FrameLayout>
</LinearLayout>
