<?xml version="1.0" encoding="utf-8"?>
<!-- test26 T7 — Document list item (spec U4).
     Card: margins 6/4, radius 14, glass_surface, stroke 1 cyan_border_hair at rest;
     selected: stroke 2 cyan_primary. Min height 88dp.
     Thumbnail: 56×72, radius 8, no stroke, no vignette.
     Line 1: name (16sp, sans-serif-medium) · "Locked" badge (11sp, gold).
     Line 2: meta (12sp). Line 3: search snippet (12sp, gone by default).
     Line 4: category chip + "Searchable" when isSearchable.
     Trailing: btnMore (48×48) or checkbox in selection mode.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    android:minHeight="88dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/glass_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/cyan_border_hair"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Category colour rail: 4dp wide, full height -->
        <View
            android:id="@+id/catRail"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:layout_gravity="fill_vertical"
            android:backgroundTint="@color/cyan_primary" />

        <!-- Thumbnail: 56×72, radius 8 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/scanThumb"
            android:layout_width="56dp"
            android:layout_height="72dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:layout_marginVertical="8dp"
            app:cardBackgroundColor="@color/void_abyss"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/cyan_border_idle"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_document" />

            <!-- Page count badge: top-start -->
            <TextView
                android:id="@+id/pageBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:background="@drawable/bg_chip_void"
                android:gravity="center"
                android:minWidth="20dp"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:textColor="@color/text_hologram_hi"
                android:textSize="12sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Text column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <!-- Line 1: document name + "Locked" badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/scanName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/text_hologram_hi"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/lockBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_lock_badge"
                    android:drawableStart="@drawable/ic_lock_small"
                    android:drawablePadding="2dp"
                    android:drawableTint="@color/pro_gold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="@string/badge_locked"
                    android:textColor="@color/pro_gold"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Line 2: meta -->
            <TextView
                android:id="@+id/scanMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_hologram_mid"
                android:textSize="12sp" />

            <!-- Line 3: search snippet (gone by default) -->
            <TextView
                android:id="@+id/scanSnippet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_hologram_mid"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Line 4: category chip + "Searchable" indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/catChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:textColor="@color/cyan_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/scanSearchable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/badge_searchable"
                    android:textColor="@color/text_hologram_mid"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Trailing: btnMore (or checkbox in selection mode) -->
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/doc_more_options"
            android:src="@drawable/ic_more"
            app:tint="@color/text_hologram_mid" />

        <CheckBox
            android:id="@+id/checkSelect"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone"
            app:buttonTint="@color/cyan_primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>