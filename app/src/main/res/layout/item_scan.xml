<?xml version="1.0" encoding="utf-8"?>
<!-- Home slice 2 — one document in the Index.
     The document is the content: a real first-page paper thumbnail (folded corner,
     category index tab, a second sheet behind multi-page documents), a serif name,
     one meta line and one honest status line. No card, no glow stroke; rows are
     separated by a quiet inset hairline (HomeRowDivider). Selected rows take an
     accent wash (state_activated) and show the checkbox instead of More.
     Thumbnail binding lives in DocThumbBinder (PageThumbLoader underneath). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:background="@drawable/bg_home_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="104dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="0dp"
    android:paddingBottom="10dp">

    <!-- Paper thumbnail: 60×80dp page, plus room for the stacked sheet and the tab.
         Decorative for TalkBack — the row description names the document. -->
    <FrameLayout
        android:id="@+id/thumbFrame"
        android:layout_width="66dp"
        android:layout_height="88dp"
        android:background="@color/sw_cc_canvas"
        android:foreground="@drawable/bg_canvas_page_edge"
        android:importantForAccessibility="noHideDescendants">

        <View
            android:id="@+id/thumbBack"
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_thumb_sheet_back"
            android:visibility="gone" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/thumbImage"
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_thumb_paper"
            app:shapeAppearance="@style/ShapeAppearance.ScanWhirl.Paper" />

        <ImageView
            android:id="@+id/thumbFold"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="51dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@null"
            android:src="@drawable/bg_thumb_fold" />

        <View
            android:id="@+id/thumbTab"
            android:layout_width="16dp"
            android:layout_height="5dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_thumb_tab" />

        <!-- Why there is no picture: lock (password), private (vault), PDF-only, unreadable. -->
        <ImageView
            android:id="@+id/thumbGlyph"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@null"
            android:visibility="gone"
            app:tint="@color/rv_ink_2" />

        <!-- Page count on the paper (multi-page documents only). -->
        <TextView
            android:id="@+id/pageBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_home_page_badge"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:minWidth="20dp"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:textColor="@color/rv_ink"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="5" />
    </FrameLayout>

    <!-- Text column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Line 1: name + "Locked" (M08: the app's sans, like every other title) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/scanName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="4"
                android:textColor="@color/rv_ink"
                android:textSize="17sp"
                tools:text="Scholarship application" />

            <TextView
                android:id="@+id/lockBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:drawableStart="@drawable/ic_sw_lock"
                android:drawablePadding="3dp"
                android:drawableTint="@color/rv_ink_2"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/badge_locked"
                android:textColor="@color/rv_ink_2"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Line 2: pages · size · date -->
        <TextView
            android:id="@+id/scanMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="3"
            android:textColor="@color/rv_ink_2"
            android:textSize="13sp"
            tools:text="5 pages · 1.4 MB · 11 Nov" />

        <!-- Retrieval slice 5: said when the document matches but no single page
             holds every term (terms spread over pages, or over name and text). -->
        <TextView
            android:id="@+id/matchScope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/page_hit_across"
            android:textColor="@color/rv_ink_3"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Search hit: why this document matched (document-level, not a page jump). -->
        <TextView
            android:id="@+id/scanSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/rv_ink_2"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Retrieval slice 5: matching pages (every term on that page), filled by
             PageHitViews from the row's RowMatch. Search only; never on blank Home. -->
        <LinearLayout
            android:id="@+id/pageHits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Shown only when the user prefers an external viewer: page links still open here. -->
        <TextView
            android:id="@+id/pageHitNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/page_hit_reader_note"
            android:textColor="@color/rv_ink_3"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Line 3: category (tap = move) + honest text status. A flow row: the
             status sits beside the category and drops below it at large font sizes. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/statusRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:layout_marginBottom="-6dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="0dp"
            app:singleLine="false">

            <TextView
                android:id="@+id/catChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/bg_home_swatch"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:minHeight="48dp"
                android:paddingEnd="8dp"
                android:textSize="13sp"
                tools:text="Forms" />

            <TextView
                android:id="@+id/scanTextStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Search ready" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/doc_more_options"
        android:src="@drawable/ic_sw_more"
        app:tint="@color/rv_ink_2" />

    <CheckBox
        android:id="@+id/checkSelect"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:buttonTint="@color/rv_accent" />
</LinearLayout>
