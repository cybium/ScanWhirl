<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sf_appbar"
        app:elevation="0dp">

        <!-- v2 UI: 07_reader_dock — the document name is the screen's one H1 and wraps to
             two lines before it ellipsises (never a one-line cut). The title is painted in
             code (DocumentViewerActivity.styleDocTitle) because Toolbar builds its own
             title TextView; the bar grows only when the name really needs the second line. -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/pageCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/text_hologram_mid"
                android:textSize="13sp" />

            <!-- v2 UI: 07_reader_dock — the folder/category pill is metadata: a compact 32 dp
                 tonal pill (13 sp sentence-case label, 8 dp dot in the category's colour)
                 centred on the meta line. The 48 dp touch area lives on this transparent
                 container, so the tap target is big while the visible chip stays small. -->
            <FrameLayout
                android:id="@+id/docCategoryTouch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:clipChildren="false"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/docCategoryChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_category_chip_tonal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone">

                    <View
                        android:id="@+id/docCategoryDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_category_dot"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/docCategoryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_hologram_mid"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/docVaultBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_lock_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/badge_vault"
                android:textColor="@color/pro_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/docLockBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lock_badge"
                android:drawableStart="@drawable/ic_lock_small"
                android:drawablePadding="4dp"
                android:drawableTint="@color/pro_gold"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/badge_locked"
                android:textColor="@color/pro_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Organize pages (owner revision): a CamScanner-style top bar. It exists only
             while pages are selected; long-press enters this mode. -->
        <LinearLayout
            android:id="@+id/selectionTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/sw_space_3"
            android:paddingVertical="@dimen/sw_space_1"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnSelClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sheet_close"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sym_close"
                app:tint="@color/text_hologram_hi" />

            <TextView
                android:id="@+id/selCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sw_space_2"
                android:layout_weight="1"
                android:textColor="@color/text_hologram_hi"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSelAll"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/sw_space_3"
                android:text="@string/draft_select_all"
                android:textColor="@color/cyan_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty state: a document always has pages today, but the draft/grid must never be
             a dead end (owner: Add pages also lives here). -->
        <LinearLayout
            android:id="@+id/gridEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grid_empty"
                android:textColor="@color/text_hologram_mid"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnEmptyAddPages"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/sw_space_2"
                android:gravity="center"
                android:paddingHorizontal="@dimen/sw_space_4"
                android:text="@string/add_pages"
                android:textColor="@color/cyan_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- v2 UI: 07_reader_dock — a long document must show that the grid continues: a
             visible vertical scrollbar (never fading) inside the grid's padding. -->
        <com.scanwhirl.app.ui.pagegrid.PageGridView
            android:id="@+id/pageList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fadeScrollbars="false"
            android:padding="12dp"
            android:scrollbarStyle="insideInset"
            android:scrollbars="vertical" />

        <!-- PM-2.2c: the draft bar appears after the first page edit. Discard always
             works; the saved document changes only on Save as new or Replace. -->
        <LinearLayout
            android:id="@+id/draftBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="6dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/draftHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_hologram_hi"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDraftDiscard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:drawableStart="@drawable/ic_sym_close"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/text_hologram_hi"
                    android:gravity="center"
                    android:maxLines="3"
                    android:text="@string/draft_bar_discard"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnDraftReplace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:drawableStart="@drawable/ic_sym_content_copy"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/text_hologram_hi"
                    android:gravity="center"
                    android:maxLines="3"
                    android:text="@string/draft_bar_replace"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnDraftSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_sym_download"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/sw_disc_ink"
                    android:gravity="center"
                    android:maxLines="3"
                    android:text="@string/draft_bar_save"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Organize pages (owner revision): the selection action bar replaces the dock while
             pages are selected. Icons + short labels, kit colours (painted in code). -->
        <LinearLayout
            android:id="@+id/selectionActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnSelRotate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:maxLines="3"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sw_rotate"
                android:drawablePadding="3dp"
                android:drawableTint="@color/cyan_primary"
                android:gravity="center"
                android:text="@string/action_rotate"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSelDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:maxLines="3"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sw_delete"
                android:drawablePadding="3dp"
                android:drawableTint="@color/laser_danger"
                android:gravity="center"
                android:text="@string/delete"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSelExtract"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:maxLines="3"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sym_content_cut"
                android:drawablePadding="3dp"
                android:drawableTint="@color/cyan_primary"
                android:gravity="center"
                android:text="@string/extract"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSelShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:maxLines="3"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sym_share"
                android:drawablePadding="3dp"
                android:drawableTint="@color/cyan_primary"
                android:gravity="center"
                android:text="@string/share_pdf"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSelMore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:maxLines="3"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sym_more_horiz"
                android:drawablePadding="3dp"
                android:drawableTint="@color/cyan_primary"
                android:gravity="center"
                android:text="@string/more"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- v2 UI: 07_reader_dock — one fixed dock order, left to right: Edit · Text · More ·
             Share. Work on the document first, send it away last. Four equal-width items
             (weight 1 each), each >= 56 dp tall, 24 dp icon over one 12 sp label. Every
             action and handler is unchanged; only the order and the spacing are. -->
        <LinearLayout
            android:id="@+id/bottomDock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_dock_glass"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="0dp"
                android:text="@string/edit"
                app:icon="@drawable/ic_edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnText"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="0dp"
                android:text="@string/btn_text"
                app:icon="@drawable/ic_ocr" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMore"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="0dp"
                android:text="@string/more"
                app:icon="@drawable/ic_more" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="0dp"
                android:text="@string/share_pdf"
                app:icon="@drawable/ic_share" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
