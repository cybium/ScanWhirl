<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sf_appbar"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/pageCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- test25 Phase 5C: additive ID — category tag, filled in reloadDocument(). -->
            <!-- test26 T5.2 (D-H): 10sp → 12sp, tappable (T4.6). -->
            <TextView
                android:id="@+id/docCategoryChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_void"
                android:letterSpacing="0.08"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textAllCaps="true"
                android:textColor="@color/cyan_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/docVaultBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_lock_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/badge_vault"
                android:textColor="@color/pro_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/docLockBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lock_badge"
                android:drawableStart="@drawable/ic_lock_small"
                android:drawablePadding="4dp"
                android:drawableTint="@color/pro_gold"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/badge_locked"
                android:textColor="@color/pro_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Organize pages (owner revision): a CamScanner-style top bar. It exists only
             while pages are selected; long-press enters this mode. -->
        <LinearLayout
            android:id="@+id/selectionTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/sw_space_3"
            android:paddingVertical="@dimen/sw_space_1"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnSelClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sheet_close"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sym_close"
                app:tint="@color/text_hologram_hi" />

            <TextView
                android:id="@+id/selCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sw_space_2"
                android:layout_weight="1"
                android:textColor="@color/text_hologram_hi"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSelAll"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/sw_space_3"
                android:text="@string/draft_select_all"
                android:textColor="@color/cyan_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty state: a document always has pages today, but the draft/grid must never be
             a dead end (owner: Add pages also lives here). -->
        <LinearLayout
            android:id="@+id/gridEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grid_empty"
                android:textColor="@color/text_hologram_mid"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnEmptyAddPages"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/sw_space_2"
                android:gravity="center"
                android:paddingHorizontal="@dimen/sw_space_4"
                android:text="@string/add_pages"
                android:textColor="@color/cyan_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.scanwhirl.app.ui.pagegrid.PageGridView
            android:id="@+id/pageList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="12dp" />

        <!-- PM-2.2c: the draft bar appears after the first page edit. Discard always
             works; the saved document changes only on Save as new or Replace. -->
        <LinearLayout
            android:id="@+id/draftBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="6dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/draftHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_hologram_hi"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDraftDiscard"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="@string/draft_discard"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnDraftReplace"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="@string/draft_replace"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnDraftSave"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:text="@string/draft_save_new"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Organize pages (owner revision): the selection action bar replaces the dock while
             pages are selected. Icons + short labels, kit colours (painted in code). -->
        <LinearLayout
            android:id="@+id/selectionActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnSelRotate"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sw_rotate"
                android:drawablePadding="3dp"
                android:drawableTint="@color/cyan_primary"
                android:gravity="center"
                android:text="@string/action_rotate"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSelDelete"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sw_delete"
                android:drawablePadding="3dp"
                android:drawableTint="@color/laser_danger"
                android:gravity="center"
                android:text="@string/delete"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSelExtract"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sym_content_cut"
                android:drawablePadding="3dp"
                android:drawableTint="@color/cyan_primary"
                android:gravity="center"
                android:text="@string/extract"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSelShare"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sym_share"
                android:drawablePadding="3dp"
                android:drawableTint="@color/cyan_primary"
                android:gravity="center"
                android:text="@string/share_pdf"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnSelMore"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sym_more_horiz"
                android:drawablePadding="3dp"
                android:drawableTint="@color/cyan_primary"
                android:gravity="center"
                android:text="@string/more"
                android:textColor="@color/text_hologram_hi"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- test26 T5.2 (§4.5/§5.4): the bottom dock is [Share w2][Edit][Text]
             [More] — four DockItem buttons, weighted 2/1/1/1, no fixed heights.
             The gold Pro Tools tray, the crown button and the old
             Delete/Share row are gone (N12: one home per action). -->
        <LinearLayout
            android:id="@+id/bottomDock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_dock_glass"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:paddingHorizontal="2dp"
                android:text="@string/share_pdf"
                app:icon="@drawable/ic_share" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:text="@string/edit"
                app:icon="@drawable/ic_edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnText"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:text="@string/btn_text"
                app:icon="@drawable/ic_ocr" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMore"
                style="@style/Widget.ScanWhirl.Button.DockItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:text="@string/more"
                app:icon="@drawable/ic_more" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
