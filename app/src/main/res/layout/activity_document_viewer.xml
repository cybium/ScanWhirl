<?xml version="1.0" encoding="utf-8"?>
<!--
  UI-B6 (GPT judgement 2026-11-19b, item 1 — "Make Document the workspace").

  V3 (screenshot critique runs 5-6): the saved-document screen keeps ONE compact dock row of
  four actions: Edit &amp; crop (the only filled cyan button), OCR, Share and Actions.
  Compress, Sign and "Save copy to Documents" moved into the Actions sheet, together with the
  rest of the secondary list. The dock prints no heading and no save explanation, and the
  header is short so the document dominates. Compress / Sign / Save keep their ids and
  listeners in a GONE container so the existing behaviour tests still drive the same handlers.

  Standard type keeps the panel pinned at the bottom in one row. From 160 % type it moves INTO
  the scroll flow above the pages as two growing columns
  (DocumentViewerActivity.applyActionPanel / moveActionPanel): one scroll owner, no clipped
  labels, no ellipsis. Page tiles keep their tap, selection and reorder behaviour.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sf_appbar"
        app:elevation="0dp">

        <!-- Back plus the brand mark in the same leading position as the Library bar. The
             document's own name no longer lives in the toolbar: it is the header's H1 below,
             where it can wrap at 200 % instead of being cut to one toolbar line. The mark is
             decorative (the screen's title is the document name). -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:contentInsetStart="4dp"
            app:contentInsetStartWithNavigation="4dp"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:titleTextColor="?attr/colorOnSurface">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/docBrandMark"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/avd_sw_brand_whirl" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/app_name"
                    android:textColor="@color/text_hologram_mid"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- The document name is the screen's H1: it wraps as far as it needs (never an
             ellipsis at 200 %), and the meta line below carries pages, size and category. -->
        <LinearLayout
            android:id="@+id/docHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/docName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:lineSpacingMultiplier="1.05"
                android:textColor="@color/v3_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/docMetaRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <TextView
                    android:id="@+id/pageCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="3"
                    android:textColor="@color/v3_text_primary"
                    android:textSize="14sp" />

                <!-- v2 UI: 07_reader_dock — the folder/category pill is metadata: a compact
                     32 dp tonal pill (13 sp sentence-case label, 8 dp dot in the category's
                     colour) centred on the meta line. This 48 dp container is the tap target
                     (it carries the spoken label), so the target is big while the visible chip
                     stays small. -->
                <FrameLayout
                    android:id="@+id/docCategoryTouch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:clipChildren="false"
                    android:focusable="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/docCategoryChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_category_chip_tonal"
                        android:gravity="center_vertical"
                        android:minHeight="32dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:visibility="gone">

                        <View
                            android:id="@+id/docCategoryDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_category_dot"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/docCategoryLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/v3_text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/docVaultBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_lock_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="@string/badge_vault"
                    android:textColor="@color/pro_gold"
                    android:textSize="@dimen/ux_uxg_viewer_meta"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/docLockBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_lock_badge"
                    android:drawableStart="@drawable/ic_lock_small"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/pro_gold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="@string/badge_locked"
                    android:textColor="@color/pro_gold"
                    android:textSize="@dimen/ux_uxg_viewer_meta"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- UX-L4-01: selection is discoverable, not a hidden long-press. A named
                 48dp control enters the same selection mode the long-press/drag uses. -->
            <com.scanwhirl.app.ui.kit.UxgActionTextView
                android:id="@id/ux130_l4_select_pages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:drawableStart="@drawable/ic_sym_check_circle"
                android:drawablePadding="4dp"
                android:drawableTint="@color/cyan_primary"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="@string/ux130_l4_select_pages"
                android:textColor="@color/cyan_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- V2V: protection is on the exported/shared PDF. Say that plainly;
                 the pages in this private library copy stay readable by design. -->
            <TextView
                android:id="@id/v2v_protected_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_category_chip_tonal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="@string/v3_protected_banner"
                android:textColor="@color/v3_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Organize pages (owner revision): a CamScanner-style top bar. It exists only
             while pages are selected; long-press enters this mode. -->
        <LinearLayout
            android:id="@+id/selectionTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/sw_space_3"
            android:paddingVertical="@dimen/sw_space_1"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnSelClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sheet_close"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sym_close"
                app:tint="@color/text_hologram_hi" />

            <TextView
                android:id="@+id/selCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sw_space_2"
                android:layout_weight="1"
                android:textColor="@color/text_hologram_hi"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSelAll"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/sw_space_3"
                android:text="@string/draft_select_all"
                android:textColor="@color/cyan_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty state: a document always has pages today, but the draft/grid must never be
             a dead end (owner: Add pages also lives here). -->
        <LinearLayout
            android:id="@+id/gridEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grid_empty"
                android:textColor="@color/text_hologram_mid"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnEmptyAddPages"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/sw_space_2"
                android:gravity="center"
                android:paddingHorizontal="@dimen/sw_space_4"
                android:text="@string/add_pages"
                android:textColor="@color/cyan_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- The one scroll owner of the page area. Standard type: the grid scrolls here and
             the action panel stays pinned below. From 160 % type the panel and the grid both
             move into actionFlowScroll (panel first), so there is still exactly one scroller
             and the action area is never squeezed into a fixed dock. -->
        <FrameLayout
            android:id="@+id/pagesHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- v2 UI: 07_reader_dock — a long document must show that the grid continues: a
                 visible vertical scrollbar (never fading) inside the grid's padding. -->
            <com.scanwhirl.app.ui.pagegrid.PageGridView
                android:id="@+id/pageList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:padding="12dp"
                android:scrollbarStyle="insideInset"
                android:scrollbars="vertical" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/actionFlowScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/actionFlowColumn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <!-- PM-2.2c: the draft bar appears after the first page edit. Discard always
             works; the saved document changes only on Save as new or Replace. -->
        <LinearLayout
            android:id="@+id/draftBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="6dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/draftHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_hologram_hi"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDraftDiscard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:drawableStart="@drawable/ic_sym_close"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/text_hologram_hi"
                    android:gravity="center"
                    android:maxLines="3"
                    android:text="@string/draft_bar_discard"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnDraftReplace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:drawableStart="@drawable/ic_sym_content_copy"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/text_hologram_hi"
                    android:gravity="center"
                    android:maxLines="3"
                    android:text="@string/draft_bar_replace"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnDraftSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_sym_download"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/sw_disc_ink"
                    android:gravity="center"
                    android:maxLines="3"
                    android:text="@string/draft_bar_save"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Organize pages (owner revision): the selection action bar replaces the dock while
             pages are selected. Icons + short labels, kit colours (painted in code). -->
        <LinearLayout
            android:id="@+id/selectionActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnSelRotate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:maxLines="3"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sw_rotate"
                android:drawablePadding="3dp"
                android:drawableTint="@color/cyan_primary"
                android:gravity="center"
                android:text="@string/action_rotate"
                android:textColor="@color/text_hologram_hi"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnSelDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:maxLines="3"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sw_delete"
                android:drawablePadding="3dp"
                android:drawableTint="@color/laser_danger"
                android:gravity="center"
                android:text="@string/delete"
                android:textColor="@color/text_hologram_hi"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnSelExtract"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:maxLines="3"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sym_content_cut"
                android:drawablePadding="3dp"
                android:drawableTint="@color/cyan_primary"
                android:gravity="center"
                android:text="@string/extract"
                android:textColor="@color/text_hologram_hi"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnSelShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:maxLines="3"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sym_share"
                android:drawablePadding="3dp"
                android:drawableTint="@color/cyan_primary"
                android:gravity="center"
                android:text="@string/share_pdf"
                android:textColor="@color/text_hologram_hi"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnSelMore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:maxLines="3"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_sym_more_horiz"
                android:drawablePadding="3dp"
                android:drawableTint="@color/cyan_primary"
                android:gravity="center"
                android:text="@string/more"
                android:textColor="@color/text_hologram_hi"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- The document workspace dock: four NAMED actions, each its own 48 dp+ target with
             an ic_sym glyph and a label that may wrap but is never ellipsized. Edit &amp; crop is
             the only filled cyan button. The row is built in DocumentViewerActivity.applyActionPanel
             (one row, or two growing columns from 160 %). -->
        <LinearLayout
            android:id="@+id/bottomDock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_dock_glass"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <!-- V3: the dock no longer prints its own heading. The sheet is the one
                 named "Document actions" surface; kept as a view for the source/tests
                 that still bind it, but never shown to the person. -->
            <TextView
                android:id="@+id/actionPanelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/doc_actions_header"
                android:textColor="@color/text_hologram_mid"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Shown only while the document cannot hand its pages to a tool (locked or
                 Vault): the same words the Actions sheet prints under the disabled rows. -->
            <TextView
                android:id="@+id/actionPanelReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/v3_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/actionGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    style="@style/Widget.ScanWhirl.Button.DockItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:maxLines="3"
                    android:paddingHorizontal="2dp"
                    android:text="@string/doc_action_edit_crop"
                    android:textColor="@color/sw_disc_ink"
                    android:textSize="14sp"
                    app:backgroundTint="@color/cyan_primary"
                    app:icon="@drawable/ic_sym_edit"
                    app:iconTint="@color/sw_disc_ink" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnText"
                    style="@style/Widget.ScanWhirl.Button.DockItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:maxLines="3"
                    android:paddingHorizontal="2dp"
                    android:text="@string/dock_read_text"
                    android:textColor="@color/v3_text_primary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/glass_surface_raised"
                    app:icon="@drawable/ic_sym_ocr" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    style="@style/Widget.ScanWhirl.Button.DockItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:maxLines="3"
                    android:paddingHorizontal="2dp"
                    android:text="@string/share_pdf"
                    android:textColor="@color/v3_text_primary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/glass_surface_raised"
                    app:icon="@drawable/ic_sym_share" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMore"
                    style="@style/Widget.ScanWhirl.Button.DockItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:maxLines="3"
                    android:paddingHorizontal="2dp"
                    android:text="@string/doc_actions"
                    android:textColor="@color/v3_text_primary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/glass_surface_raised"
                    app:icon="@drawable/ic_sym_more_horiz" />
            </LinearLayout>

            <!-- V3: these three actions moved INTO the document Actions sheet. Their
                 ids and click listeners stay here (GONE) so the existing, unchanged
                 behaviour tests still drive the same guarded handlers by id; the
                 person reaches them through the sheet's named rows instead. -->
            <LinearLayout
                android:id="@+id/hiddenDockActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompress"
                    style="@style/Widget.ScanWhirl.Button.DockItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:maxLines="3"
                    android:paddingHorizontal="2dp"
                    android:text="@string/tool_compress"
                    app:backgroundTint="@color/glass_surface_raised"
                    app:icon="@drawable/ic_sym_compress" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSign"
                    style="@style/Widget.ScanWhirl.Button.DockItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:maxLines="3"
                    android:paddingHorizontal="2dp"
                    android:text="@string/tool_sign"
                    app:backgroundTint="@color/glass_surface_raised"
                    app:icon="@drawable/ic_sym_signature" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSavePdf"
                    style="@style/Widget.ScanWhirl.Button.DockItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:maxLines="3"
                    android:paddingHorizontal="2dp"
                    android:text="@string/v3_save_copy"
                    app:backgroundTint="@color/glass_surface_raised"
                    app:icon="@drawable/ic_sym_download" />
            </LinearLayout>

            <TextView
                android:id="@+id/actionPanelHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/doc_action_save_hint"
                android:textColor="@color/text_hologram_mid"
                android:textSize="@dimen/ux_uxg_viewer_meta"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
