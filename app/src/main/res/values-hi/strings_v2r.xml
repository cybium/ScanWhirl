    <!-- Vault removal: safe move-back first, permanent delete behind its own confirm. -->
    <string name="v2r_vault_remove_choices_note">जोड़ने पर कागज़ात वाली प्रति हटा दी गई थी। इस सुरक्षित प्रति के साथ क्या करें, चुनें।</string>
    <string name="v2r_vault_move_back">कागज़ात में वापस रखें</string>
    <string name="v2r_vault_delete_forever">हमेशा के लिए हटाएँ</string>
    <string name="v2r_vault_delete_confirm_title">%1$s को हमेशा के लिए हटाएँ?</string>
    <string name="v2r_vault_delete_confirm_body">तिजोरी से \"%1$s\" हटाएँ? यह कागज़ात में नहीं होगा। इसे वापस नहीं लाया जा सकता।</string>
    <string name="v2r_vault_move_back_done">%1$s को कागज़ात में वापस रख दिया गया। तिजोरी में याद रखा गया PDF पासवर्ड साथ नहीं आता।</string>
    <string name="v2r_vault_move_back_failed">%1$s को वापस नहीं रख सके। तिजोरी वाली प्रति नहीं बदली गई।</string>
    <string name="v2r_vault_move_back_partial">कागज़ात वाली प्रति तैयार है, पर तिजोरी वाली प्रति अभी भी है। इसे इसी मेन्यू से हटाएँ।</string>

