<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Legacy storage permission for Android 9 and older only (the app writes into Documents
         through MediaStore on newer versions). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Security audit: ScanWhirl is offline by design. ML Kit's code scanner pulls in Google's
         telemetry transport (transport-runtime / transport-backend-cct) and okhttp, and THOSE
         libraries declare INTERNET and ACCESS_NETWORK_STATE. The app never opens a socket, so the
         permission is stripped from the merged manifest for the shipped build. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- L2: fingerprint/face unlock for the Vault (API 28+); the passcode works everywhere. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".ScanWhirlApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScanWhirl"
        android:enableOnBackInvokedCallback="true">

        <!-- test26 T3.9: Home is the launcher now; the globe activity stays
             in the tree (unreachable) until T7 removes it. -->
        <!-- v2 shell: Library · Tools · Scan · Vault · Me (01_home_A). -->
        <activity
            android:name=".ui.shell.ShellActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- L2 v2 Vault (04_vault): setup, unlock, private files, backup/restore. -->
        <activity
            android:name=".ui.vault.VaultActivity"
            android:exported="false"
            android:parentActivityName=".ui.shell.ShellActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- L2 v2 QR code reader: scan result, actions and the local history. -->
        <activity
            android:name=".ui.qr.QrActivity"
            android:exported="false"
            android:parentActivityName=".ui.shell.ShellActivity" />

        <!-- The legacy home is kept until every flow has moved to the shell. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name=".ui.DocumentViewerActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.PdfViewerActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.TrashActivity"
            android:exported="false"
            android:label="@string/trash_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.MergePdfActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- v2 UI: 03_tools_hub — the L4 shared setup, result and passport-crop screens. -->
        <activity
            android:name=".ui.tools.ToolSetupActivity"
            android:exported="false"
            android:parentActivityName=".ui.shell.ShellActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.tools.ToolResultActivity"
            android:exported="false"
            android:parentActivityName=".ui.shell.ShellActivity" />

        <activity
            android:name=".ui.tools.PassportActivity"
            android:exported="false"
            android:parentActivityName=".ui.shell.ShellActivity" />

        <activity
            android:name=".ui.tools.IdCardActivity"
            android:exported="false"
            android:parentActivityName=".ui.shell.ShellActivity" />

        <activity
            android:name=".ui.tools.BusinessCardActivity"
            android:exported="false"
            android:parentActivityName=".ui.shell.ShellActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ExportResultActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- L3: Book pages — split a photographed two-page spread (Create group). -->
        <activity
            android:name=".ui.book.BookPagesActivity"
            android:exported="false"
            android:parentActivityName=".ui.shell.ShellActivity" />

        <activity
            android:name=".ui.PageViewerActivity"
            android:exported="false"
            android:parentActivityName=".ui.DocumentViewerActivity" />

        <!-- L5 Edit & sign: the stamp editor (Sign / text / draw / highlight / watermark /
             page numbers / stamp / redact). Launched with a document id and optional tool. -->
        <activity
            android:name=".ui.stamp.StampEditorActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ScanReviewActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- test26 P6 OCR Editor (§4.7): adjustResize keeps the keyboard off the EditText. -->
        <activity
            android:name=".ui.OcrEditorActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Stores the in-app language on Android < 13 (AppCompat per-app locale). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- PM-1.5: the app has no INTERNET permission, so ask Google Play to install the unbundled
             ML Kit text-recognition (Latin) and code-scanner modules together with the app, instead of
             on first use. (Devanagari OCR is bundled in the APK; the document scanner is a Play services module.) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,barcode_ui" />
    </application>
</manifest>
